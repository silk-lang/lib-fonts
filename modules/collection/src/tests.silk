//! System font discovery tests. They read the machine's installed fonts, so they assert only on
//! macOS, where the faces every install ships are known. Fallback tests run everywhere.
import fallback_tests as _fallback_tests

static if Intrinsic.targetOperatingSystem() == "darwin" {
  import collection { FontCollection, Family }
  import system { Options }
  import system
  import svg_fonts.database { Generic }
  import svg_fonts.matching { Request, Selection, Style }
  import svg_fonts.names
  import silk.collections.bytes { Bytes }
  import silk.collections.list { List }
  import silk.core.effect { Effect }
  import silk.core.option { Option }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.platform.native.host_input { NativeHostInput }
  import silk.system.host_input { HostInput, HostInputError }
  import silk.system.host_input_native { OsHostInput }
  import silk.testing.testing { Testing, AssertionError }

  fn hasFamily(fonts: &FontCollection, face: usize, name: &[u8]) -> bool {
    let families = &fonts.face(face).families
    let mut i: usize = 0
    while i < List<Bytes>.length(families) {
      if names.same(Bytes.asSlice(&List<Bytes>.asSlice(families)[i]), name) {
        return true
      }
      i = i + 1
    }
    return false
  }

  effect fn expectGeneric(
    fonts: &FontCollection,
    generic: Generic,
    family: &[u8],
    label: string<'static>,
  ) -> ()
    ! AssertionError<'static> | OutOfMemoryError
    ? &mut Allocator {
    let request = Request { weight: 400.0, width: 100.0, style: Style.Normal }
    match run fonts.matchFamily(&Family.generic(generic), request) {
      Option<Selection>.Some { value } => {
        run Testing.expect(hasFamily(&fonts, value.face, family), label)
        run Testing.expect(value.weight == 400.0, "a regular request selects weight 400")
      }
      Option<Selection>.None => run Testing.expect(false, label)
    }
  }

  effect fn resolvesGenerics() -> ()
    ! AssertionError<'static> | HostInputError | OutOfMemoryError
    ? &mut Allocator {
    let snapshot = run unsafe NativeHostInput.environmentSnapshot()
    let mut inputs = OsHostInput.make(move snapshot)
    let mut fonts = FontCollection.make()
    drop run system.load(&mut fonts, Options.defaults())
      |> Effect.provideMut<HostInput>(&mut inputs)
    run expectGeneric(&fonts, Generic.SystemUi, b"System Font", "system-ui is SFNS.ttf")
    run expectGeneric(&fonts, Generic.SansSerif, b"Helvetica", "sans-serif is Helvetica")
    run expectGeneric(&fonts, Generic.Monospace, b"Menlo", "monospace is Menlo")
    run expectGeneric(&fonts, Generic.UiMonospace, b".SF NS Mono", "ui-monospace is SF Mono")
  }

  // Chromium's macOS defaults: system-ui is San Francisco, sans-serif Helvetica, monospace Menlo.
  test effect fn macGenericFamilies() -> ()
    ! AssertionError<'static> | HostInputError | OutOfMemoryError {
    let mut allocator = Allocator.systemAllocatorProvider()
    run resolvesGenerics() |> Effect.provideMut<Allocator>(&mut allocator)
  }
}

static if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
  import collection { FontCollection as Fonts }
  import system { Options as Budget, Report }
  import system as discovery
  import silk.collections.bytes { Bytes as Buffer }
  import silk.core.effect { Effect as Run }
  import silk.mem.allocator { Allocator as Memory, OutOfMemoryError as NoMemory }
  import silk.platform.native.host_input { NativeHostInput as Host }
  import silk.system.filesystem { FileSystem, Path, FileError }
  import silk.system.filesystem_machine { MachineFileSystem }
  import silk.system.host_input { HostInputError as NoHost }
  import silk.testing.testing { Testing as Check, AssertionError as Failed }

  effect fn mapsFile() -> ()
    ! Failed<'static> | FileError | NoHost | NoMemory
    ? &mut Memory {
    let mut absolute = run Host.workingDirectory()
    run Buffer.append(&mut absolute, b"/test-support/fonts/NotoSans-Regular.subset.ttf")
    let path = run Path.fromBytes(Buffer.asSlice(&absolute))
    let mut files = run MachineFileSystem.make()
    let mut fonts = Fonts.make()
    let mut report = Report.empty()
    run discovery.file(&mut fonts, &path, &Budget { maxFiles: 8, maxBytes: 0, maxDepth: 1 }, &mut report)
      |> Run.provideMut<FileSystem>(&mut files)
    run Check.expect(report.files == 1 && report.bytes == 0 && report.mapped > 0, "the file is mapped")
    run Check.expect(fonts.faceCount() == 1, "the mapped file adds its face")
    run Check.expect(fonts.data(0).length == report.mapped, "the face reads the whole mapping")
    run Check.expect(fonts.font(0).isSome(), "the face parses from the mapping")
  }

  // System font files are mapped, not copied: a zero heap budget still adds the face, and its
  // bytes read through the mapping.
  test effect fn mapsFontFiles() -> ()
    ! Failed<'static> | FileError | NoHost | NoMemory {
    let mut allocator = Memory.systemAllocatorProvider()
    run mapsFile() |> Run.provideMut<Memory>(&mut allocator)
  }
}
