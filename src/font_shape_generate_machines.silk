import font_shape_generate_common as G
import font_shape_generate_common { Hit, Named, Tag }
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.text.regex { Regex, RegexError, Match }
import silk.text.string { String }
import silk.num.u8
import silk.num.u64
import silk.num.u32
import silk.num.usize

struct Arm<'a> { key: string<'a>, content: string<'a>, conditional: bool }
struct Table { name: String, values: List<u64> }
struct Program { id: u64, bytes: Bytes }
struct Pair { script: u64, first: u64, second: u64 }
impl Order for Pair {
  fn compare(left: &Pair, right: &Pair) -> Ordering {
    if left.script < right.script { return Ordering.Less }
    if left.script > right.script { return Ordering.Greater }
    if left.first < right.first { return Ordering.Less }
    if left.first > right.first { return Ordering.Greater }
    if left.second < right.second { return Ordering.Less }
    if left.second > right.second { return Ordering.Greater }
    return Ordering.Equal
  }
}
effect fn arms<'a>(text: string<'a>) -> List<Arm<'a>> ! TaskError | OutOfMemoryError ? &mut Allocator {
  let pattern = run Effect.catch<RegexError>(Regex.compile("([\\w\\s|]+)\\s*=>\\s*(match\\s*\\(act\\)\\s*)?\\{"), G.regexFailure)
  let mut result = List<Arm<'a>>.make()
  let mut pos: usize = 0
  while pos < String.byteLength(text) {
    let found = run Effect.catch<RegexError>(Regex.find(&pattern, String.slice(text, pos, String.byteLength(text) - pos)), G.regexFailure)
    match move found {
      Option<Match<'a>>.None => { break }
      Option<Match<'a>>.Some { value } => {
        let content = run G.body(text, pos + Match.end(&value) - 1)
        let key = Match.group(&value, 1) |> Option<string>.unwrapOr("")
        let condition = Match.group(&value, 2)
        let conditional = Option<string>.isSome(&condition)
        run List<Arm<'a>>.append(&mut result, Arm<'a> { key: String.trim(key), content: content.text, conditional: conditional })
        pos = content.end
      }
    }
  }
  return move result
}
effect fn actionCode(text: string, kinds: &[Named]) -> Bytes ! TaskError | OutOfMemoryError ? &mut Allocator {
  let matches = run G.hits("te\\s*=\\s*p\\s*\\+\\s*1;|te\\s*=\\s*p;|p\\s*=\\s*p\\s*-\\s*1;|p\\s*=\\s*\\(te\\)\\s*-\\s*1;|act\\s*=\\s*(\\d+);|found_syllable!\\(SyllableType::(\\w+)\\)", text)
  let rows = List<Hit>.asSlice(&matches)
  let mut instructions = Bytes.make()
  let mut i: usize = 0
  while i < rows.length {
    let token = run G.replace(G.group(&rows[i], 0), "\\s+", "")
    let v = String.view(&token)
    if v == "te=p+1;" { run Bytes.append(&mut instructions, &[1, 0]) }
    else if v == "te=p;" { run Bytes.append(&mut instructions, &[2, 0]) }
    else if v == "p=p-1;" { run Bytes.append(&mut instructions, &[3, 0]) }
    else if v == "p=(te)-1;" { run Bytes.append(&mut instructions, &[4, 0]) }
    else if G.group(&rows[i], 1) != "" {
      run G.integer(&mut instructions, 5, 1)
      run G.integer(&mut instructions, run G.number(G.group(&rows[i], 1)), 1)
    } else {
      run G.integer(&mut instructions, 6, 1)
      run G.integer(&mut instructions, run G.lookup(kinds, G.group(&rows[i], 2)), 1)
    }
    i = i + 1
  }
  let code = Bytes.asSlice(&instructions)
  let mut fused = Bytes.make()
  i = 0
  while i < code.length {
    if i + 5 < code.length && code[i] == 2 && code[i + 1] == 0 && code[i + 2] == 3 && code[i + 3] == 0 && code[i + 4] == 6 {
      run Bytes.append(&mut fused, &[8, code[i + 5]])
      i = i + 6
    } else if i + 3 < code.length && code[i] == 4 && code[i + 1] == 0 && code[i + 2] == 6 {
      run Bytes.append(&mut fused, &[9, code[i + 3]])
      i = i + 4
    } else {
      run Bytes.append(&mut fused, Slice.view<u8>(code, i, 2))
      i = i + 2
    }
  }
  return move fused
}
effect fn values<'a>(tables: &'a [Table], name: string) -> &'a [u64] ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < tables.length {
    if String.view(&tables[i].name) == name { return List<u64>.asSlice(&tables[i].values) }
    i = i + 1
  }
  return run Task.abort("missing Ragel transition table")
}
fn codeFor<'a>(programs: &'a [Program], id: u64) -> &'a [u8] {
  let mut i: usize = 0
  while i < programs.length {
    if programs[i].id == id { return Bytes.asSlice(&programs[i].bytes) }
    i = i + 1
  }
  return b""
}
effect fn namedFunction(out: &mut String, name: string, suffix: string, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut function = run String.copy(name)
  run String.append(&mut function, suffix)
  run G.byteFunction(&mut out, String.view(&function), bytes)
}
fn target(state: usize, froms: &[u64], tos: &[u64]) -> u64 {
  return usize.toU64(state) | (if tos[state] != 0 { u32.toU64(0x8000) } else { u32.toU64(0) }) | (if froms[state] != 0 { u32.toU64(0x4000) } else { u32.toU64(0) })
}
effect fn machine(root: &Path, out: &mut String, name: string) -> () ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut path = run String.copy("ot/shaper/")
  run String.append(&mut path, name)
  run String.append(&mut path, "_machine.rs")
  let source = run G.source(root, String.view(&path))
  let src = String.view(&source)
  let mut prefix = run String.copy("_")
  run String.append(&mut prefix, name)
  run String.append(&mut prefix, "_syllable_machine_")
  let mut tablePattern = run String.copy("static ")
  run String.append(&mut tablePattern, String.view(&prefix))
  run String.append(&mut tablePattern, "(\\w+):\\s*\\[")
  let tableMatches = run G.hits(String.view(&tablePattern), src)
  let tableRows = List<Hit>.asSlice(&tableMatches)
  let mut allTables = List<Table>.make()
  let mut i: usize = 0
  while i < tableRows.length {
    let key = G.group(&tableRows[i], 1)
    let mut fullName = run String.copy(String.view(&prefix))
    run String.append(&mut fullName, key)
    let tableText = run G.array(src, String.view(&fullName))
    run List<Table>.append(&mut allTables, Table { name: run String.copy(key), values: run G.numbers(String.view(&tableText)) })
    i = i + 1
  }
  let tables = List<Table>.asSlice(&allTables)
  let mut startPattern = run String.copy("static ")
  run String.append(&mut startPattern, name)
  run String.append(&mut startPattern, "_syllable_machine_start: i32 = (\\d+)")
  let startMatches = run G.hits(String.view(&startPattern), src)
  run G.require(List<Hit>.length(&startMatches) == 1, "missing Ragel initial state")
  let start = run G.number(G.group(&List<Hit>.asSlice(&startMatches)[0], 1))
  let enumBody = run G.body(src, run G.index(src, "pub enum SyllableType"))
  let kindMatches = run G.hits("(\\w+)(?:\\s*=\\s*\\d+)?\\s*(?:,|$)", enumBody.text)
  let kindRows = List<Hit>.asSlice(&kindMatches)
  let mut allKinds = List<Named>.make()
  i = 0
  while i < kindRows.length {
    run List<Named>.append(&mut allKinds, Named { name: run String.copy(G.group(&kindRows[i], 1)), value: usize.toU64(i) })
    i = i + 1
  }
  let kinds = List<Named>.asSlice(&allKinds)
  let mut targetMarker = run String.copy("cs = (")
  run String.append(&mut targetMarker, String.view(&prefix))
  run String.append(&mut targetMarker, "cond_targs")
  let transitionStart = run G.index(src, String.view(&targetMarker))
  let mut actionMarker = run String.copy("match (")
  run String.append(&mut actionMarker, String.view(&prefix))
  run String.append(&mut actionMarker, if name == "khmer" { "actions[(_acts)" } else { "cond_actions" })
  let actionStart = transitionStart + run G.index(String.slice(src, transitionStart, String.byteLength(src) - transitionStart), String.view(&actionMarker))
  let actionBody = run G.body(src, actionStart)
  let actionArms = run arms(actionBody.text)
  let actions = List<Arm>.asSlice(&actionArms)
  let mut codes = List<Program>.make()
  i = 0
  while i < actions.length {
    if actions[i].key != "_" {
      let mut code = Bytes.make()
      if actions[i].conditional {
        let nestedArms = run arms(actions[i].content)
        let branches = List<Arm>.asSlice(&nestedArms)
        let mut j: usize = 0
        while j < branches.length {
          if branches[j].key != "_" {
            let insns = run actionCode(branches[j].content, kinds)
            run G.integer(&mut code, 7, 1)
            run G.integer(&mut code, run G.number(branches[j].key), 1)
            run G.integer(&mut code, usize.toU64(Bytes.length(&insns)), 1)
            run Bytes.append(&mut code, Bytes.asSlice(&insns))
          }
          j = j + 1
        }
      } else { code = run actionCode(actions[i].content, kinds) }
      run List<Program>.append(&mut codes, Program { id: run G.number(actions[i].key), bytes: move code })
    }
    i = i + 1
  }
  let condActions = run values(tables, "cond_actions")
  let mut ids = List<u64>.make()
  run List<u64>.appendSlice(&mut ids, condActions)
  run List<u64>.sort(&mut ids)
  let orderedIds = List<u64>.asSlice(&ids)
  let mut programs = run Bytes.copy(&[0])
  let mut offsets = List<u64>.make()
  let maximum = orderedIds[orderedIds.length - 1]
  run List<u64>.appendRepeated(&mut offsets, 0, u64.toUsize(maximum + 1))
  let khmerActions = if name == "khmer" { run values(tables, "actions") } else { &[] }
  i = 0
  while i < orderedIds.length {
    let id = orderedIds[i]
    if i == 0 || orderedIds[i - 1] != id {
      List<u64>.set(&mut offsets, u64.toUsize(id), usize.toU64(Bytes.length(&programs)))
      if name == "khmer" {
        let begin = u64.toUsize(id) + 1
        let end = begin + u64.toUsize(khmerActions[u64.toUsize(id)])
        let mut j = begin
        while j < end {
          run Bytes.append(&mut programs, codeFor(List<Program>.asSlice(&codes), khmerActions[j]))
          j = j + 1
        }
      } else { run Bytes.append(&mut programs, codeFor(List<Program>.asSlice(&codes), id)) }
      run G.integer(&mut programs, 0, 1)
    }
    i = i + 1
  }
  let eof = run values(tables, "eof_trans")
  let states = eof.length
  run G.require(states < 0x4000, "too many Ragel states")
  let mut fromValues = List<u64>.make()
  let mut toValues = List<u64>.make()
  run List<u64>.appendSlice(&mut fromValues, run values(tables, "from_state_actions"))
  run List<u64>.appendSlice(&mut toValues, run values(tables, "to_state_actions"))
  if name == "khmer" {
    let froms = List<u64>.asMutSlice(&mut fromValues)
    let tos = List<u64>.asMutSlice(&mut toValues)
    i = 0
    while i < states {
      froms[i] = if khmerActions[u64.toUsize(froms[i])] != 0 { 1 } else { 0 }
      tos[i] = if khmerActions[u64.toUsize(tos[i])] != 0 { 1 } else { 0 }
      i = i + 1
    }
  }
  let froms = List<u64>.asSlice(&fromValues)
  let tos = List<u64>.asSlice(&toValues)
  let keys = run values(tables, "trans_keys")
  let indexOffsets = run values(tables, "index_offsets")
  let targets = run values(tables, "cond_targs")
  let keyOffsets = if name == "khmer" { run values(tables, "key_offsets") } else { &[] }
  let singles = if name == "khmer" { run values(tables, "single_lengths") } else { &[] }
  let ranges = if name == "khmer" { run values(tables, "range_lengths") } else { &[] }
  let classes = if name != "khmer" { run values(tables, "char_class") } else { &[] }
  let defaults = if name != "khmer" { run values(tables, "index_defaults") } else { &[] }
  let indices = if name != "khmer" { run values(tables, "indices") } else { &[] }
  let programOffsets = List<u64>.asSlice(&offsets)
  let mut matrix = run Bytes.makeWithCapacity(states * 60 * 4)
  let mut state: usize = 0
  while state < states {
    let mut category: u64 = 0
    while category < 60 {
      let mut trans: usize = 0
      let mut absent = false
      if category == 59 {
        if eof[state] == 0 { absent = true }
        else { trans = u64.toUsize(eof[state] - 1) }
      } else if name == "khmer" {
        let mut key = u64.toUsize(keyOffsets[state])
        trans = u64.toUsize(indexOffsets[state])
        let singleCount = u64.toUsize(singles[state])
        let rangeCount = u64.toUsize(ranges[state])
        let mut found = false
        let mut k: usize = 0
        while k < singleCount {
          if keys[key + k] == category {
            trans = trans + k
            found = true
            break
          }
          k = k + 1
        }
        if !found {
          trans = trans + singleCount
          key = key + singleCount
          k = 0
          while k < rangeCount {
            if keys[key + k * 2] <= category && category <= keys[key + k * 2 + 1] {
              trans = trans + k
              found = true
              break
            }
            k = k + 1
          }
          if !found { trans = trans + rangeCount }
        }
      } else {
        let bias: u64 = if name == "indic" || name == "myanmar" { 1 } else { 0 }
        let maximum: u64 = if name == "use" { 56 } else { 57 }
        trans = u64.toUsize(defaults[state])
        if bias <= category && category <= maximum && state * 2 + 1 < keys.length {
          let ic = classes[u64.toUsize(category - bias)]
          let lo = keys[state * 2]
          let hi = keys[state * 2 + 1]
          if lo <= ic && ic <= hi { trans = u64.toUsize(indices[u64.toUsize(indexOffsets[state] + ic - lo)]) }
        }
      }
      if absent {
        run G.integer(&mut matrix, target(state, froms, tos), 2)
        run G.integer(&mut matrix, 0, 2)
      } else {
        run G.integer(&mut matrix, target(u64.toUsize(targets[trans]), froms, tos), 2)
        run G.integer(&mut matrix, programOffsets[u64.toUsize(condActions[trans])], 2)
      }
      category = category + 1
    }
    state = state + 1
  }
  let mut broken: u64 = 255
  i = 0
  while i < kinds.length {
    if String.view(&kinds[i].name) == "BrokenCluster" { broken = kinds[i].value }
    i = i + 1
  }
  let mut header = Bytes.make()
  run G.packed(&mut header, &[start, broken], 2)
  i = 0
  while i < froms.length {
    run G.integer(&mut header, if froms[i] != 0 { 1 } else { 0 }, 1)
    i = i + 1
  }
  i = 0
  while i < tos.length {
    run G.integer(&mut header, if tos[i] != 0 { 1 } else { 0 }, 1)
    i = i + 1
  }
  run namedFunction(&mut out, name, "States", Bytes.asSlice(&header))
  run namedFunction(&mut out, name, "Transitions", Bytes.asSlice(&matrix))
  run namedFunction(&mut out, name, "Actions", Bytes.asSlice(&programs))
}

pub effect fn generateShapingMachines(root: &Path) -> () ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut out = run String.copy("// THIS FILE IS AUTOGENERATED by silk task generate-shaping-machines. DO NOT EDIT.\n// From pinned Harfrust/HarfBuzz shaping data, MIT licensed.\n")
  let indic = run G.source(root, "ot/shaper/indic_table.rs")
  let indicSource = run G.source(root, "ot/shaper/indic.rs")
  let constants = run G.constants(String.view(&indicSource))
  let aliasMatches = run G.hits("use (\\w+)\\s+as (\\w+);", String.view(&indic))
  let aliases = List<Hit>.asSlice(&aliasMatches)
  let indicArray = run G.array(String.view(&indic), "indic_values")
  let valueMatches = run G.hits("indic_combine_categories\\((\\w+),\\s*(\\w+)\\)", String.view(&indicArray))
  let rows = List<Hit>.asSlice(&valueMatches)
  let mut data = Bytes.make()
  let mut i: usize = 0
  while i < rows.length {
    let a = run aliasValue(aliases, List<Named>.asSlice(&constants), G.group(&rows[i], 1))
    let b = run aliasValue(aliases, List<Named>.asSlice(&constants), G.group(&rows[i], 2))
    run G.integer(&mut data, a + 256 * b, 2)
    i = i + 1
  }
  run G.byteFunction(&mut out, "indicValues", Bytes.asSlice(&data))
  let indicData = run G.array(String.view(&indic), "indic_u8")
  let indicNumbers = run G.numbers(String.view(&indicData))
  Bytes.clear(&mut data)
  run G.packed(&mut data, List<u64>.asSlice(&indicNumbers), 1)
  run G.byteFunction(&mut out, "indicData", Bytes.asSlice(&data))
  let useTable = run G.source(root, "ot/shaper/use_table.rs")
  let useSource = run G.source(root, "ot/shaper/use_.rs")
  let useConstants = run G.constants(String.view(&useSource))
  let useNames = &["use_u8", "use_u16"]
  i = 0
  while i < useNames.length {
    let text = run G.array(String.view(&useTable), useNames[i])
    let matches = run G.hits("\\b[A-Za-z]\\w*\\b", String.view(&text))
    let names = List<Hit>.asSlice(&matches)
    let mut substituted = String.make()
    let mut at: usize = 0
    let mut j: usize = 0
    while j < names.length {
      run String.append(&mut substituted, String.slice(String.view(&text), at, names[j].start - at))
      run G.decimal(&mut substituted, run G.lookup(List<Named>.asSlice(&useConstants), G.group(&names[j], 0)))
      at = names[j].end
      j = j + 1
    }
    run String.append(&mut substituted, String.slice(String.view(&text), at, String.ownedByteLength(&text) - at))
    let values = run G.numbers(String.view(&substituted))
    Bytes.clear(&mut data)
    run G.packed(&mut data, List<u64>.asSlice(&values), i + 1)
    run G.byteFunction(&mut out, useNames[i], Bytes.asSlice(&data))
    i = i + 1
  }
  let machines = &["indic", "khmer", "myanmar", "use"]
  i = 0
  while i < machines.length {
    run machine(root, &mut out, machines[i])
    i = i + 1
  }
  let scriptNames = run G.scripts(root)
  let scripts = List<Tag>.asSlice(&scriptNames)
  let shapers = run G.source(root, "ot/shaper/mod.rs")
  // The original generator used Python's str.split(marker, 1)[0], which keeps the whole tail
  // when the marker is absent; the pinned harfrust source wraps this arm, so it is absent.
  let tail = run G.after(String.view(&shapers), "// Unicode-2.0 additions")
  let universal = match String.find(tail, "=> &use_::UNIVERSAL_SHAPER") {
    Option<usize>.Some { value } => String.slice(tail, 0, value)
    Option<usize>.None => tail
  }
  let scriptMatches = run G.hits("Script::(\\w+)", universal)
  let scriptRows = List<Hit>.asSlice(&scriptMatches)
  Bytes.clear(&mut data)
  i = 0
  while i < scriptRows.length {
    run Bytes.append(&mut data, String.utf8Bytes(run G.tag(scripts, G.group(&scriptRows[i], 1))))
    i = i + 1
  }
  run G.byteFunction(&mut out, "universalScripts", Bytes.asSlice(&data))
  run constraints(root, &mut out, scripts)
  run G.save(root, "modules/shape/src/generated_machines.silk", String.view(&out))
}
effect fn aliasValue(aliases: &[Hit<'_>], constants: &[Named], alias: string) -> u64 ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut i = aliases.length
  while i > 0 {
    i = i - 1
    if G.group(&aliases[i], 2) == alias { return run G.lookup(constants, G.group(&aliases[i], 1)) }
  }
  return run Task.abort("unknown Indic category alias")
}
fn tagNumber(tag: string) -> u64 {
  let bytes = String.utf8Bytes(tag)
  let mut value: u64 = 0
  let mut i: usize = 0
  while i < bytes.length {
    value = value * 256 + u8.toU64(bytes[i])
    i = i + 1
  }
  return value
}
effect fn hexNumbers(text: string, pattern: string, group: usize) -> List<u64> ! TaskError | OutOfMemoryError ? &mut Allocator {
  let found = run G.hits(pattern, text)
  let rows = List<Hit>.asSlice(&found)
  let mut result = List<u64>.make()
  let mut i: usize = 0
  while i < rows.length {
    run List<u64>.append(&mut result, run G.number(G.group(&rows[i], group)))
    i = i + 1
  }
  return move result
}
effect fn constraints(root: &Path, out: &mut String, scripts: &[Tag]) -> () ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let source = run G.source(root, "ot/shaper/vowel_constraints.rs")
  let src = String.view(&source)
  let scriptMatches = run G.hits("Some\\(Script::(\\w+)\\) =>", src)
  let scriptRows = List<Hit>.asSlice(&scriptMatches)
  let mut pairs = List<Pair>.make()
  let outerPattern = run Effect.catch<RegexError>(Regex.compile("((?:0x[0-9A-Fa-f]+\\s*\\|?\\s*)+) =>\\s*(match cur_glyph\\(buffer, 1\\))?"), G.regexFailure)
  let mut i: usize = 0
  while i < scriptRows.length {
    let content = run G.body(src, scriptRows[i].end)
    if let Option<usize>.Some { value } = move String.find(content.text, "match cur_glyph(buffer, 0)") {
      let cursor = run G.body(content.text, value + String.byteLength("match cur_glyph(buffer, 0)"))
      let mut pos: usize = 0
      while pos < String.byteLength(cursor.text) {
        let found = run Effect.catch<RegexError>(Regex.find(&outerPattern, String.slice(cursor.text, pos, String.byteLength(cursor.text) - pos)), G.regexFailure)
        match move found {
          Option<Match>.None => { break }
          Option<Match>.Some { value: matched } => {
            let branch = run G.body(cursor.text, pos + Match.end(&matched))
            let firstText = Match.group(&matched, 1) |> Option<string>.unwrapOr("")
            let firstValues = run hexNumbers(firstText, "0x[0-9a-fA-F]+", 0)
            let firsts = List<u64>.asSlice(&firstValues)
            let condition = Match.group(&matched, 2)
            let conditional = Option<string>.isSome(&condition)
            let mut secondValues = List<u64>.make()
            if conditional {
              let matches = run G.hits("((?:0x[0-9A-Fa-f]+\\s*\\|?\\s*)+) =>\\s*\\{\\s*matched = true;", branch.text)
              let seconds = List<Hit>.asSlice(&matches)
              let mut j: usize = 0
              while j < seconds.length {
                let values = run hexNumbers(G.group(&seconds[j], 1), "0x[0-9a-fA-F]+", 0)
                run List<u64>.appendSlice(&mut secondValues, List<u64>.asSlice(&values))
                j = j + 1
              }
            } else {
              secondValues = run hexNumbers(branch.text, "matched = (0x\\w+) == cur_glyph\\(buffer, 1\\)", 1)
            }
            let seconds = List<u64>.asSlice(&secondValues)
            let script = tagNumber(run G.tag(scripts, G.group(&scriptRows[i], 1)))
            let mut a: usize = 0
            while a < firsts.length {
              let mut b: usize = 0
              while b < seconds.length {
                run List<Pair>.append(&mut pairs, Pair { script: script, first: firsts[a], second: seconds[b] })
                b = b + 1
              }
              a = a + 1
            }
            pos = branch.end
          }
        }
      }
    }
    i = i + 1
  }
  run List<Pair>.append(&mut pairs, Pair { script: tagNumber("Taml"), first: 0xb85, second: 0xbc2 })
  run List<Pair>.sort(&mut pairs)
  let rows = List<Pair>.asSlice(&pairs)
  let mut data = Bytes.make()
  let mut index = Bytes.make()
  i = 0
  while i < rows.length {
    let start = i
    let script = rows[i].script
    while i < rows.length && rows[i].script == script {
      run G.packed(&mut data, &[script, rows[i].first, rows[i].second], 4)
      i = i + 1
    }
    run G.integer(&mut index, script, 4)
    run G.integer(&mut index, usize.toU64(start), 2)
    run G.integer(&mut index, usize.toU64(i), 2)
  }
  run G.byteFunction(&mut out, "vowelConstraints", Bytes.asSlice(&data))
  run G.byteFunction(&mut out, "vowelScripts", Bytes.asSlice(&index))
}
