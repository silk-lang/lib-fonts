import font_shape_generate_common as G
import font_shape_generate_common { Hit, Named, Tag }
import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.text.string { String }
import silk.num.u64
import silk.num.usize

pub effect fn generateShapingUnicode(root: &Path) -> ()
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let scriptNames = run G.scripts(root)
  let scripts = List<Tag>.asSlice(&scriptNames)
  let mut out = run String.copy(
    "// THIS FILE IS AUTOGENERATED by silk task generate-shaping-unicode. DO NOT EDIT.\n// Unicode 18 data from Harfrust 1503ff0. Copyright HarfBuzz developers. MIT.\n",
  )
  let unicode = run G.source(root, "unicode/mod.rs")
  let mut modified = run G.array(String.view(&unicode), "MODIFIED_COMBINING_CLASS")
  let modules = &["modified_combining_class", "combining_class"]
  let mut mi: usize = 0
  while mi < modules.length {
    let mut marker = run String.copy("mod ")
    run String.append(&mut marker, modules[mi])
    run String.append(&mut marker, " {")
    let section = run G.body(
      String.view(&unicode),
      run G.index(String.view(&unicode), String.view(&marker)),
    )
    let constants = run G.constants(section.text)
    let mut pattern = run String.copy("\\b")
    run String.append(&mut pattern, modules[mi])
    run String.append(&mut pattern, "::(\\w+)")
    let matches = run G.hits(String.view(&pattern), String.view(&modified))
    let rows = List<Hit>.asSlice(&matches)
    let mut next = String.make()
    let mut at: usize = 0
    let mut i: usize = 0
    while i < rows.length {
      run String.append(&mut next, String.slice(String.view(&modified), at, rows[i].start - at))
      run G.decimal(&mut next, run G.lookup(List<Named>.asSlice(&constants), G.group(&rows[i], 1)))
      at = rows[i].end
      i = i + 1
    }
    run String.append(
      &mut next,
      String.slice(String.view(&modified), at, String.ownedByteLength(&modified) - at),
    )
    drop rows
    drop matches
    modified = move next
    mi = mi + 1
  }
  let values = run G.numbers(String.view(&modified))
  let mut data = Bytes.make()
  run G.packed(&mut data, List<u64>.asSlice(&values), 1)
  run G.byteFunction(&mut out, "modifiedClasses", Bytes.asSlice(&data))
  let direction = run G.source(root, "direction.rs")
  let rtl = run G.before(run G.after(String.view(&direction), "// Unicode-1.1 additions"), "=>")
  let rtlMatches = run G.hits("Script::(\\w+)", rtl)
  let rtlRows = List<Hit>.asSlice(&rtlMatches)
  run String.append(
    &mut out,
    "pub fn isRtlScript(script: u32) -> bool {\n  return match script {\n",
  )
  let mut i: usize = 0
  while i < rtlRows.length {
    run String.append(&mut out, "    0x")
    run G.hex(&mut out, String.utf8Bytes(run G.tag(scripts, G.group(&rtlRows[i], 1))))
    run String.append(&mut out, " => true\n")
    i = i + 1
  }
  run String.append(&mut out, "    _ => false\n  }\n}\n")
  let arabic = run G.source(root, "ot/shaper/arabic_table.rs")
  run numericRows(
    &mut out,
    "arabicForms",
    String.view(&arabic),
    "\\((0x\\w+), \\[(0x\\w+), (0x\\w+), (0x\\w+), (0x\\w+)\\]\\)",
    5,
    2,
  )
  let arabicSource = run G.source(root, "ot/shaper/arabic.rs")
  let states = run G.array(String.view(&arabicSource), "STATE_TABLE")
  let stateMatches = run G.hits(
    "\\(arabic_action::(\\w+), arabic_action::(\\w+), (\\d+)\\)",
    String.view(&states),
  )
  let stateRows = List<Hit>.asSlice(&stateMatches)
  Bytes.clear(&mut data)
  i = 0
  while i < stateRows.length {
    run G.integer(
      &mut data,
      run action(
        G.group(&stateRows[i], 1),
        &["ISOL", "FINA", "FIN2", "FIN3", "MEDI", "MED2", "INIT", "NONE"],
      ),
      1,
    )
    run G.integer(
      &mut data,
      run action(
        G.group(&stateRows[i], 2),
        &["ISOL", "FINA", "FIN2", "FIN3", "MEDI", "MED2", "INIT", "NONE"],
      ),
      1,
    )
    run G.integer(&mut data, run G.number(G.group(&stateRows[i], 3)), 1)
    i = i + 1
  }
  run G.byteFunction(&mut out, "arabicStates", Bytes.asSlice(&data))
  let thai = run G.source(root, "ot/shaper/thai.rs")
  let edgeMatches = run G.hits(
    "[AB]SME::new\\(Action::(\\w+), (?:AboveState::T|BelowState::B)(\\d)\\)",
    String.view(&thai),
  )
  let edges = List<Hit>.asSlice(&edgeMatches)
  Bytes.clear(&mut data)
  i = 0
  while i < edges.length {
    run G.integer(
      &mut data,
      run action(G.group(&edges[i], 1), &["NOP", "SD", "SL", "SDL", "RD"]),
      1,
    )
    run G.integer(&mut data, run G.number(G.group(&edges[i], 2)), 1)
    i = i + 1
  }
  run G.byteFunction(&mut out, "thaiStates", Bytes.asSlice(&data))
  Bytes.clear(&mut data)
  let actions = &["SD", "SL", "SDL", "RD"]
  i = 0
  while i < actions.length {
    let mut name = run String.copy(actions[i])
    run String.append(&mut name, "_MAPPINGS")
    let table = run G.array(String.view(&thai), String.view(&name))
    let matches = run G.hits(
      "PuaMapping::new\\((0x\\w+), (0x\\w+), (0x\\w+)\\)",
      String.view(&table),
    )
    let rows = List<Hit>.asSlice(&matches)
    let mut j: usize = 0
    while j < rows.length {
      run G.integer(&mut data, usize.toU64(i + 1), 2)
      let mut k: usize = 1
      while k <= 3 {
        run G.integer(&mut data, run G.number(G.group(&rows[j], k)), 2)
        k = k + 1
      }
      j = j + 1
    }
    i = i + 1
  }
  run G.byteFunction(&mut out, "thaiMappings", Bytes.asSlice(&data))
  let pua = run G.source(root, "ot/shaper/arabic_pua.rs")
  let smallText = run G.array(String.view(&pua), "arabic_pua_u8")
  let wideText = run G.array(String.view(&pua), "arabic_pua_u16")
  let smallValues = run G.numbers(String.view(&smallText))
  let wideValues = run G.numbers(String.view(&wideText))
  let small = List<u64>.asSlice(&smallValues)
  let wide = List<u64>.asSlice(&wideValues)
  Bytes.clear(&mut data)
  let mut cp: u64 = 0
  while cp < 65277 {
    let mut at = ((u64.shiftRight(13835058055282164225, u64.shiftRight(cp, 11) * 2)) & 3) * 16
      + ((u64.shiftRight(cp, 7)) & 15)
    let simp = wide[u64.toUsize(
      small[u64.toUsize(31 + nibble(small, 0, at) * 16 + ((u64.shiftRight(cp, 3)) & 15))] * 8
        + (cp & 7),
    )]
    at = nibble(small, 127, u64.shiftRight(cp, 10)) * 16 + ((u64.shiftRight(cp, 6)) & 15)
    let trad = wide[u64.toUsize(
      317
        + small[u64.toUsize(197 + nibble(small, 159, at) * 16 + ((u64.shiftRight(cp, 2)) & 15))] * 4
        + (cp & 3),
    )]
    if simp != 0 || trad != 0 {
      run G.integer(&mut data, cp, 4)
      run G.integer(&mut data, simp, 2)
      run G.integer(&mut data, trad, 2)
    }
    cp = cp + 1
  }
  run G.byteFunction(&mut out, "arabicSymbol", Bytes.asSlice(&data))
  Bytes.clear(&mut data)
  let ligatureNames = &["LIGATURE_3_TABLE", "LIGATURE_TABLE", "LIGATURE_MARK_TABLE"]
  i = 0
  while i < ligatureNames.length {
    let table = run G.array(String.view(&arabic), ligatureNames[i])
    let matches = run G.hits("\\(\\[([^\\]]+)\\], (0x\\w+)\\)", String.view(&table))
    let rows = List<Hit>.asSlice(&matches)
    let mut j: usize = 0
    while j < rows.length {
      let components = run G.numbers(G.group(&rows[j], 1))
      let cps = List<u64>.asSlice(&components)
      run G.require(cps.length <= 3, "oversize Arabic ligature")
      run G.integer(&mut data, usize.toU64(i), 1)
      run G.integer(&mut data, usize.toU64(cps.length), 1)
      let mut k: usize = 0
      while k < 3 {
        run G.integer(
          &mut data,
          if k < cps.length {
            cps[k]
          } else {
            0
          },
          2,
        )
        k = k + 1
      }
      run G.integer(&mut data, run G.number(G.group(&rows[j], 2)), 2)
      j = j + 1
    }
    i = i + 1
  }
  run G.byteFunction(&mut out, "arabicLigatures", Bytes.asSlice(&data))
  let win = run G.source(root, "ot/shaper/arabic_fallback.rs")
  let winNames = &["WIN1256_INIT_MAPPINGS", "WIN1256_MEDI_MAPPINGS", "WIN1256_FINA_MAPPINGS"]
  Bytes.clear(&mut data)
  i = 0
  while i < winNames.length {
    let table = run G.array(String.view(&win), winNames[i])
    let matches = run G.hits("\\((\\d+), (\\d+)\\)", String.view(&table))
    let rows = List<Hit>.asSlice(&matches)
    let mut j: usize = 0
    while j < rows.length {
      run G.integer(&mut data, usize.toU64(i), 2)
      run G.integer(&mut data, run G.number(G.group(&rows[j], 1)), 2)
      run G.integer(&mut data, run G.number(G.group(&rows[j], 2)), 2)
      j = j + 1
    }
    i = i + 1
  }
  run G.byteFunction(&mut out, "arabicWindows", Bytes.asSlice(&data))
  let aat = run G.source(root, "aat/layout.rs")
  let constants = run G.constants(String.view(&aat))
  let featureMatches = run G.hits(
    "FeatureMapping::new\\(b\"(....)\", (\\w+), (\\w+), (\\w+)\\)",
    String.view(&aat),
  )
  let features = List<Hit>.asSlice(&featureMatches)
  run G.require(features.length > 70, "missing AAT features")
  Bytes.clear(&mut data)
  i = 0
  while i < features.length {
    run Bytes.append(&mut data, String.utf8Bytes(G.group(&features[i], 1)))
    let mut j: usize = 2
    while j <= 4 {
      let raw = G.group(&features[i], j)
      let first = String.utf8Bytes(raw)[0]
      let value = if first >= 48 && first <= 57 {
        run G.number(raw)
      } else {
        run G.lookup(List<Named>.asSlice(&constants), raw)
      }
      run G.integer(&mut data, value, 1)
      j = j + 1
    }
    i = i + 1
  }
  run G.byteFunction(&mut out, "aatFeatures", Bytes.asSlice(&data))
  run G.save(root, "modules/shape/src/generated_unicode.silk", String.view(&out))
}

effect fn action(name: string, names: &[string]) -> u64
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < names.length {
    if names[i] == name {
      return usize.toU64(i)
    }
    i = i + 1
  }
  run G.require(false, "unknown shaping action")
  return 0
}

fn nibble(small: &[u64], base: usize, i: u64) -> u64 {
  return (u64.shiftRight(small[base + u64.toUsize(i / 2)], 4 * (i & 1))) & 15
}

effect fn numericRows(
  out: &mut String,
  name: string,
  text: string,
  pattern: string,
  count: usize,
  width: usize,
) -> ()
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let matches = run G.hits(pattern, text)
  let rows = List<Hit>.asSlice(&matches)
  let mut data = Bytes.make()
  let mut i: usize = 0
  while i < rows.length {
    let mut j: usize = 1
    while j <= count {
      run G.integer(&mut data, run G.number(G.group(&rows[i], j)), width)
      j = j + 1
    }
    i = i + 1
  }
  run G.byteFunction(&mut out, name, Bytes.asSlice(&data))
}
