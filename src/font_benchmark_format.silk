import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.format { Format }
import silk.text.string { String }
import silk.num.f64
import silk.num.i64
import silk.num.u8
import silk.num.usize

struct Buffer {
  bytes: [u8; 64],
  length: usize
}

impl Writer for Buffer {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> ()
    ! WriterError {
    if bytes.length > 64 - self.length {
      fail Writer.failure()
    }
    let mut at: usize = 0
    while at < bytes.length {
      self.bytes[self.length + at] = bytes[at]
      at = at + 1
    }
    self.length = self.length + bytes.length
  }

  effect fn flush(self: &mut Self) -> () ! WriterError {}
}

// Six significant digits, using Python's .6g exponent thresholds and spelling.
pub effect fn general(value: f64) -> String
  ! WriterError | OutOfMemoryError
  ? &mut Allocator {
  if f64.isNaN(value) {
    return run String.copy("nan")
  }
  if f64.isInfinite(value) {
    return run String.copy(
      if value < 0.0 {
        "-inf"
      } else {
        "inf"
      },
    )
  }
  let mut buffer = Buffer { bytes: [0; 64], length: 0 }
  run Format.format("{value:.5e}", &.{ value: value }) |> Effect.provideMut<Writer>(&mut buffer)
  let input = Slice.view<u8>(&buffer.bytes, 0, buffer.length)
  let mut digits: [u8; 6] = [48; 6]
  let negative = input[0] == 45
  let mut at: usize = if negative {
    1
  } else {
    0
  }
  let mut count: usize = 0
  while at < input.length && input[at] != 101 {
    if input[at] != 46 {
      digits[count] = input[at]
      count = count + 1
    }
    at = at + 1
  }
  at = at + 1
  let mut sign: i64 = 1
  if input[at] == 45 {
    sign = -1
    at = at + 1
  } else if input[at] == 43 {
    at = at + 1
  }
  let mut exponent: i64 = 0
  while at < input.length {
    exponent = exponent * 10 + u8.toI64(input[at] - 48)
    at = at + 1
  }
  exponent = exponent * sign
  while count > 1 && digits[count - 1] == 48 {
    count = count - 1
  }
  let mut output = Bytes.make()
  if negative {
    run output.append(b"-")
  }
  if exponent < -4 || exponent >= 6 {
    run output.append(Slice.view<u8>(&digits, 0, 1))
    if count > 1 {
      run output.append(b".")
      run output.append(Slice.view<u8>(&digits, 1, count - 1))
    }
    run output.append(
      if exponent < 0 {
        b"e-"
      } else {
        b"e+"
      },
    )
    let magnitude = if exponent < 0 {
      -exponent
    } else {
      exponent
    }
    if magnitude < 10 {
      run output.append(b"0")
    }
    let mut number: [u8; 20] = [0; 20]
    let length = Format.writeI64Display(magnitude, &mut number, 0)
    run output.append(Slice.view<u8>(&number, 0, length))
  } else if exponent < 0 {
    run output.append(b"0.")
    let mut position: i64 = -1
    while position > exponent {
      run output.append(b"0")
      position = position - 1
    }
    run output.append(Slice.view<u8>(&digits, 0, count))
  } else {
    let whole = i64.toUsize(exponent + 1)
    at = 0
    while at < whole {
      run output.append(
        &[
          if at < count {
            digits[at]
          } else {
            48
          },
        ],
      )
      at = at + 1
    }
    if count > whole {
      run output.append(b".")
      run output.append(Slice.view<u8>(&digits, whole, count - whole))
    }
  }
  return unsafe String.fromBytesUnchecked(move output)
}
