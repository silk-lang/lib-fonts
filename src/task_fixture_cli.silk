import font_tasks { Tasks }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

pub union FixtureTasks {
  CheckCoreFixtures,
  CheckTableFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckLayoutFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckVariationFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckModelFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckAatFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckCffFixtures {
    pub reference: String,
    pub silkDumper: String,
    pub report: String,
    pub seedsOnly: bool
  },
  CheckMiscTableFixtures { pub reference: String, pub silkDumper: String, pub report: String },
}

impl CommandLine for FixtureTasks {
  static fn command() -> Command<FixtureTasks> {
    return Command<FixtureTasks>.make("fixture-tasks", "Font library maintenance")
      |> Command.option("report", Opt.about("Write results or corpus inventory as JSON"))
      |> Command.option("reference", Opt.about("Reference dumper path"))
      |> Command.option("silkDumper", Opt.about("Silk dumper path"))
      |> Command.variant("CheckCoreFixtures", "Compare focused container edge cases")
      |> Command.variant("CheckTableFixtures", "Compare core OpenType table fixtures")
      |> Command.variant(
        "CheckLayoutFixtures",
        "Compare layout tables, prefixes, aliases and offsets",
      )
      |> Command.variant(
        "CheckVariationFixtures",
        "Compare variation table fixtures and corruptions",
      )
      |> Command.variant("CheckModelFixtures", "Compare model selection and fallback edge cases")
      |> Command.variant("CheckAatFixtures", "Compare AAT table scopes, offsets and prefixes")
      |> Command.variant("CheckCffFixtures", "Compare CFF seeds, prefixes and malformed structures")
      |> Command.option("seedsOnly", Opt.about("Compare CFF seed fixtures without mutations"))
      |> Command.variant("CheckMiscTableFixtures", "Compare miscellaneous OpenType table fixtures")
  }
}

impl TaskSet for FixtureTasks {
  effect fn perform(self: FixtureTasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let task = match move self {
      FixtureTasks.CheckCoreFixtures => Tasks.CheckCoreFixtures
      FixtureTasks.CheckTableFixtures {
        reference,
        silkDumper,
        report
      } => Tasks.CheckTableFixtures {
        reference: move reference,
        silkDumper: move silkDumper,
        report: move report,
      }
      FixtureTasks.CheckLayoutFixtures {
        reference,
        silkDumper,
        report
      } => Tasks.CheckLayoutFixtures {
        reference: move reference,
        silkDumper: move silkDumper,
        report: move report,
      }
      FixtureTasks.CheckVariationFixtures {
        reference,
        silkDumper,
        report
      } => Tasks.CheckVariationFixtures {
        reference: move reference,
        silkDumper: move silkDumper,
        report: move report,
      }
      FixtureTasks.CheckModelFixtures {
        reference,
        silkDumper,
        report
      } => Tasks.CheckModelFixtures {
        reference: move reference,
        silkDumper: move silkDumper,
        report: move report,
      }
      FixtureTasks.CheckAatFixtures { reference, silkDumper, report } => Tasks.CheckAatFixtures {
        reference: move reference,
        silkDumper: move silkDumper,
        report: move report,
      }
      FixtureTasks.CheckCffFixtures {
        reference,
        silkDumper,
        report,
        seedsOnly
      } => Tasks.CheckCffFixtures {
        reference: move reference,
        silkDumper: move silkDumper,
        report: move report,
        seedsOnly: move seedsOnly,
      }
      FixtureTasks.CheckMiscTableFixtures {
        reference,
        silkDumper,
        report
      } => Tasks.CheckMiscTableFixtures {
        reference: move reference,
        silkDumper: move silkDumper,
        report: move report,
      }
    }
    run TaskSet.perform(move task)
  }
}
