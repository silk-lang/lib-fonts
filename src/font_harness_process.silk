import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Drop }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter, StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileError, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }

static if Intrinsic.targetOperatingSystem() != "windows" {
  import silk.system.subprocess { Subprocess, SubprocessError, SpawnOptions, Stdio, ExitStatus }
}

import silk.system.system_clock { SystemClock }
import silk.text.format { Format }
import silk.text.string { String }
import silk.num.f64
import silk.num.i64
import silk.num.usize

static if Intrinsic.targetOperatingSystem() != "windows" {
  unsafe extern "C" fn tmpfile() -> ?*mut u8
  unsafe extern "C" fn fclose(file: *mut u8) -> i32
  unsafe extern "C" fn fileno(file: *mut u8) -> i32
  unsafe extern "C" fn fseek(file: *mut u8, offset: i64, origin: i32) -> i32
  unsafe extern "C" fn fread(bytes: ?[*]mut u8, size: usize, count: usize, file: *mut u8) -> usize
  unsafe extern "C" fn fwrite(
    bytes: ?[*]const u8,
    size: usize,
    count: usize,
    file: *mut u8,
  ) -> usize
  unsafe extern "C" fn fopen(path: ?[*]const u8, mode: ?[*]const u8) -> ?*mut u8
  unsafe extern "C" fn ferror(file: *mut u8) -> i32
  unsafe extern "C" fn fflush(file: *mut u8) -> i32
  unsafe extern "C" fn kill(pid: i32, signal: i32) -> i32
  @foreign(noCapture: .("status"))
  unsafe extern "C" fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32

  // Anonymous disk-backed streams keep multi-gigabyte font dumps out of the heap.
  pub struct DumpFile {
    handle: *mut u8
  }
  impl Drop for DumpFile {
    fn drop(self: &mut Self) -> () {
      let _closed = unsafe fclose(self.handle)
    }
  }
  impl DumpFile {
    pub effect fn make() -> DumpFile
      ! TaskError | OutOfMemoryError
      ? &mut Allocator {
      let handle = match Pointer.nonNullMut(unsafe tmpfile()) {
        Option<*mut u8>.Some { value } => value
        Option<*mut u8>.None => run Task.abort("cannot create temporary dump file")
      }
      return DumpFile { handle: handle }
    }

    pub effect fn rewind(self: &mut Self) -> ()
      ! TaskError | OutOfMemoryError
      ? &mut Allocator {
      if unsafe fseek(self.handle, 0, 0) != 0 {
        run Task.abort("cannot rewind dump file")
      }
    }

    pub effect fn read(self: &mut Self, buffer: &mut [u8]) -> usize
      ! TaskError | OutOfMemoryError
      ? &mut Allocator {
      let length = buffer.length
      let count = unsafe fread(Pointer.fromMutSlice<u8>(&mut buffer), 1, length, self.handle)
      if unsafe ferror(self.handle) != 0 {
        run Task.abort("cannot read dump file")
      }
      return count
    }

    pub effect fn readAll(self: &mut Self) -> Bytes
      ! TaskError | OutOfMemoryError
      ? &mut Allocator {
      run self.rewind()
      let mut result = Bytes.make()
      let mut block: [u8; 65536] = [0; 65536]
      while true {
        let count = run self.read(&mut block)
        if count == 0 {
          break
        }
        run Bytes.append(&mut result, Slice.view<u8>(&block, 0, count))
      }
      return move result
    }

    pub effect fn save(self: &mut Self, path: &Path) -> ()
      ! TaskError | OutOfMemoryError
      ? &mut Allocator {
      let mut name = run Bytes.copy(Path.rawBytes(path))
      run name.append(b"\x00")
      let handle = match Pointer.nonNullMut(
        unsafe fopen(Pointer.fromSlice(name.asSlice()), Pointer.fromSlice(b"wb\x00")),
      ) {
        Option<*mut u8>.Some { value } => value
        Option<*mut u8>.None => run Task.abort("cannot create dump artifact")
      }
      let destination = DumpFile { handle: handle }
      run self.rewind()
      let mut block: [u8; 65536] = [0; 65536]
      while true {
        let count = run self.read(&mut block)
        if count == 0 {
          break
        }
        if unsafe fwrite(
          Pointer.fromSlice(Slice.view<u8>(&block, 0, count)),
          1,
          count,
          destination.handle,
        )
          != count {
          run Task.abort("cannot write dump artifact")
        }
      }
      if unsafe fflush(destination.handle) != 0 {
        run Task.abort("cannot flush dump artifact")
      }
    }
  }

  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32

    unsafe fn currentError() -> i32 {
      return unsafe Pointer.read<i32>(unsafe __error())
    }
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32

    unsafe fn currentError() -> i32 {
      return unsafe Pointer.read<i32>(unsafe __errno_location())
    }
  }

  struct RunningChild {
    pid: i32
  }
  impl Drop for RunningChild {
    fn drop(self: &mut Self) -> () {
      if self.pid > 0 {
        let _killed = unsafe kill(self.pid, 9)
        let mut status: i32 = 0

        // Reap even on allocation, filesystem, or process errors.
        while unsafe waitpid(self.pid, Pointer.fromMutRef<i32>(&mut status), 0) < 0 {
          if unsafe currentError() != 4 {
            break
          }
        }
      }
    }
  }

  pub struct RunResult {
    pub code: i32,
    pub timedOut: bool,
    pub seconds: f64,
    pub output: DumpFile,
    pub errors: DumpFile,
  }

  pub effect fn now() -> f64 {
    let mut clock = OsMonotonicClock.make()
    let instant = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut clock)
    return i64.toF64(SystemClock.seconds(&instant))
      + i64.toF64(SystemClock.nanoseconds(&instant)) / 1000000000.0
  }

  effect fn waitBriefly() -> () {
    let mut clock = OsMonotonicClock.make()
    run MonotonicClock.waitFor(1000000) |> Effect.provideMut<MonotonicClock>(&mut clock)
  }

  // Native subprocesses inherit the environment, never pass arguments through a shell,
  // and are killed and reaped when the per-invocation deadline expires.
  pub effect fn execute(
    program: string,
    arguments: &[string],
    timeout: f64,
    discardOutput: bool,
  ) -> RunResult
    ! TaskError | FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
    if !f64.isFinite(timeout) || timeout <= 0.0 {
      run Task.abort("timeout must be positive and finite")
    }
    let root = run Task.root()
    let path = if String.startsWith(program, "/") {
      run Path.make(program)
    } else {
      run Path.resolve(&root, program)
    }
    let mut request = run ChildProcess.requestWithin(&path, &root)
    let mut index: usize = 0
    while index < arguments.length {
      run ChildProcess.addArgument(&mut request, arguments[index])
      index = index + 1
    }
    run Subprocess.inheritEnvironment(&mut request)
    let output = run DumpFile.make()
    let errors = run DumpFile.make()
    let mut options = SpawnOptions.make()
    if !discardOutput {
      run options.setStdio(1, Stdio.inherit(unsafe fileno(output.handle)))
    }
    run options.setStdio(2, Stdio.inherit(unsafe fileno(errors.handle)))
    let started = run now()
    let child = match move run Effect.result(Subprocess.spawn(&request, &options)) {
      Result<Subprocess, SubprocessError | OutOfMemoryError>.Success { value } => move value
      Result<Subprocess, SubprocessError | OutOfMemoryError>.Failure { .. } => run Task.abort(
        "cannot start font executable",
      )
    }
    let mut guard = RunningChild { pid: child.pid() }
    let mut timedOut = false
    let mut code: i32 = 0
    while true {
      let status = match move run Effect.result(Subprocess.tryWait(guard.pid)) {
        Result<Option<ExitStatus>, SubprocessError>.Success { value } => move value
        Result<Option<ExitStatus>, SubprocessError>.Failure { .. } => run Task.abort(
          "cannot wait for font executable",
        )
      }
      if let Option<ExitStatus>.Some { value } = move status {
        guard.pid = 0
        code = value.code
        if value.signaled {
          code = -value.signal
        }
        break
      }
      if !timedOut && (run now()) - started >= timeout {
        if unsafe kill(guard.pid, 9) != 0 && unsafe currentError() != 3 {
          run Task.abort("cannot terminate timed-out font executable")
        }
        timedOut = true
      }
      run waitBriefly()
    }
    return RunResult {
      code: code,
      timedOut: timedOut,
      seconds: (run now()) - started,
      output: move output,
      errors: move errors,
    }
  }

  pub effect fn requireSuccess(result: &RunResult) -> ()
    ! TaskError | OutOfMemoryError
    ? &mut Allocator {
    if result.timedOut {
      run Task.abort("font executable timed out")
    }
    if result.code != 0 {
      run Task.abort("font executable failed")
    }
  }
}

pub fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + 1
  }
  return true
}

pub fn contains(haystack: &[u8], needle: &[u8]) -> bool {
  if needle.length > haystack.length {
    return false
  }
  let mut at: usize = 0
  while at <= haystack.length - needle.length {
    if equal(Slice.view<u8>(haystack, at, needle.length), needle) {
      return true
    }
    at = at + 1
  }
  return false
}

pub fn trim(value: &[u8]) -> &[u8] {
  let mut start: usize = 0
  let mut end = value.length
  while start < end && (value[start] == 32 || (value[start] >= 9 && value[start] <= 13)) {
    start = start + 1
  }
  while end > start && (value[end - 1] == 32 || (value[end - 1] >= 9 && value[end - 1] <= 13)) {
    end = end - 1
  }
  return Slice.view<u8>(value, start, end - start)
}

pub effect fn print(bytes: &[u8]) -> ()
  ! WriterError {
  let mut writer = StdoutWriter.make()
  run Writer.writeAll(bytes) |> Effect.provideMut<Writer>(&mut writer)
}

pub effect fn error(bytes: &[u8]) -> ()
  ! WriterError {
  let mut writer = StderrWriter.make()
  run Writer.writeAll(bytes) |> Effect.provideMut<Writer>(&mut writer)
}

pub effect fn number(value: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut bytes: [u8; 20] = [0; 20]
  let length = Format.writeU64Display(value, &mut bytes, 0)
  return unsafe String.fromBytesUnchecked(run Bytes.copy(Slice.view<u8>(&bytes, 0, length)))
}
