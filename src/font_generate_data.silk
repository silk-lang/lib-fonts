import font_generate_support as G
import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.regex { Match }

import silk.text.string { String }
import silk.io.writer { WriterError }
struct Source { file: string<'static>, symbol: string<'static>, target: string<'static> }

effect fn initializer(root: &Path, directory: string, file: string, name: string) -> Bytes ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let base = run Path.resolve(root, directory)
  let source = run G.read(&base, file)
  return run G.initializer(run G.text(Bytes.asSlice(&source)), name)
}
effect fn strings(out: &mut Bytes, dataName: string, offsetsName: string, values: &[Match<'_>], index: usize) -> () ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut packed = Bytes.make() let mut offsets = Bytes.make()
  let mut i: usize = 0
  while i < values.length {
    let value = &values[i] i = i + 1
    let bytes = String.utf8Bytes(G.group(value, index)) let mut at: usize = 0
    while at < bytes.length { run G.require(bytes[at] < 128, "Packed naming data must be ASCII") at = at + 1 }
    run G.be(&mut offsets, Bytes.length(&packed), 4)
    run G.add(&mut packed, G.group(value, index))
  }
  run G.be(&mut offsets, Bytes.length(&packed), 4)
  run G.blob(&mut out, dataName, Bytes.asSlice(&packed), false)
  run G.blob(&mut out, offsetsName, Bytes.asSlice(&offsets), false)
}

pub effect fn postscript(root: &Path, check: bool) -> () ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let directory = "modules/parse/upstream/read-fonts/src/ps"
  let body = run initializer(root, directory, "string.rs", "STANDARD_STRINGS")
  let values = run G.matches("\"([^\"\\\\]*)\"", run G.text(Bytes.asSlice(&body)))
  run G.require(List<Match>.length(&values) == 391, "Expected 391 PostScript standard strings")
  let mut out = Bytes.make()
  run G.add(&mut out, "// THIS FILE IS AUTOGENERATED by silk task generate-ps-data. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\nimport font_types.lib { readScalar }\nimport silk.core.option { Option }\nimport silk.collections.slice { Slice }\nimport silk.num.u8\nimport silk.num.u32\n")
  run strings(&mut out, "stringsData", "stringsOffsets", List<Match>.asSlice(&values), 1)
  let sources = [Source { file: "encoding.rs", symbol: "STANDARD_ENCODING", target: "standardEncoding" }, Source { file: "encoding.rs", symbol: "EXPERT_ENCODING", target: "expertEncoding" }, Source { file: "encoding.rs", symbol: "ISO_LATIN1_ENCODING", target: "isoLatin1Encoding" }, Source { file: "cff/charset.rs", symbol: "EXPERT_CHARSET", target: "expertCharsetData" }, Source { file: "cff/charset.rs", symbol: "EXPERT_SUBSET_CHARSET", target: "expertSubsetCharsetData" }]
  let mut sourceIndex: usize = 0
  while sourceIndex < sources.length {
    let source = &sources[sourceIndex] sourceIndex = sourceIndex + 1
    let body = run initializer(root, directory, source.file, source.symbol)
    let data = run G.numericBytes(run G.text(Bytes.asSlice(&body)), "[0-9]+", 2)
    if source.file == "encoding.rs" { run G.require(Bytes.length(&data) == 512, "Expected 256 PostScript encoding entries") }
    run G.blob(&mut out, source.target, Bytes.asSlice(&data), false)
  }
  run G.add(&mut out, "pub fn standardString(index: usize) -> Option<&'static [u8]> {\n  if index >= 391 { return Option<&'static [u8]>.None }\n  let start = readScalar<u32>(Slice.view<u8>(stringsOffsets(), index * 4, 4)) |> Option<u32>.unwrapOr(0)\n  let end = readScalar<u32>(Slice.view<u8>(stringsOffsets(), index * 4 + 4, 4)) |> Option<u32>.unwrapOr(0)\n  return Option<&'static [u8]>.some(Slice.view<u8>(stringsData(), u32.toUsize(start), u32.toUsize(end - start)))\n}\npub fn predefinedCode(encoding: u8, code: u8) -> u16 {\n  let mut data = standardEncoding()\n  if encoding == 1 { data = expertEncoding() } else if encoding == 2 { data = isoLatin1Encoding() }\n  return readScalar<u16>(Slice.view<u8>(data, u8.toUsize(code) * 2, 2)) |> Option<u16>.unwrapOr(0)\n}\npub fn expertCharset(subset: bool, index: usize) -> Option<u16> {\n  let mut data = expertCharsetData() if subset { data = expertSubsetCharsetData() }\n  if index >= data.length / 2 { return Option<u16>.None }\n  return readScalar<u16>(Slice.view<u8>(data, index * 2, 2))\n}\n")
  run G.save(root, "modules/parse/src/generated_ps_data.silk", &out, check)
  run G.report(check, "packed PostScript data")
}

pub effect fn naming(root: &Path, check: bool) -> () ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let directory = "modules/parse/upstream/read-fonts/src/tables"
  let postBody = run initializer(root, directory, "post.rs", "DEFAULT_GLYPH_NAMES")
  let post = run G.matches("\"([^\"\\\\]*)\"", run G.text(Bytes.asSlice(&postBody)))
  run G.require(List<Match>.length(&post) == 258, "Expected 258 standard glyph names")
  let macBody = run initializer(root, directory, "name.rs", "MAC_ROMAN_DECODE")
  let mac = run G.numericBytes(run G.text(Bytes.asSlice(&macBody)), "[0-9]+", 2)
  run G.require(Bytes.length(&mac) == 256, "Expected 128 Mac Roman entries")
  let languageBody = run initializer(root, directory, "name/language.rs", "LANGUAGE_ID_TO_BCP47")
  let languages = run G.matches("\\((0x[0-9a-fA-F]+|[0-9]+),\\s*\"([^\"]+)\"\\)", run G.text(Bytes.asSlice(&languageBody)))
  run G.require(List<Match>.length(&languages) > 200, "Expected more than 200 language mappings")
  let mut keys = Bytes.make() let mut previous: usize = 0
  let languageSlice = List<Match>.asSlice(&languages) let mut languageIndex: usize = 0
  while languageIndex < languageSlice.length {
    let entry = &languageSlice[languageIndex] languageIndex = languageIndex + 1
    let key = run G.number(G.group(entry, 1))
    run G.require(key >= previous, "Language mappings are not sorted") previous = key
    run G.be(&mut keys, key, 2)
  }
  let rangeBody = run initializer(root, directory, "os2.rs", "OS2_UNICODE_RANGES")
  let ranges = run G.matches("\\((0x[0-9A-Fa-f]+|[0-9]+),\\s*(0x[0-9A-Fa-f]+|[0-9]+),\\s*([0-9]+)\\)", run G.text(Bytes.asSlice(&rangeBody)))
  run G.require(List<Match>.length(&ranges) == 169, "Expected 169 OS/2 Unicode ranges")
  let mut out = Bytes.make()
  run G.add(&mut out, "// THIS FILE IS AUTOGENERATED by silk task generate-static. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n// BCP-47 mappings originate in Skia; see the retained upstream source attribution.\nimport font_types.lib { readScalar }\nimport silk.core.option { Option }\nimport silk.core.result { Result }\nimport silk.text.string { String, InvalidUtf8 }\nimport silk.collections.slice { Slice }\nimport silk.num.u32\nimport silk.core.ownership { Copy }\n")
  run strings(&mut out, "getpostNamesData", "getpostNamesOffsets", List<Match>.asSlice(&post), 1)
  run G.blob(&mut out, "getmacRomanData", Bytes.asSlice(&mac), false)
  run strings(&mut out, "getlanguagesData", "getlanguagesOffsets", List<Match>.asSlice(&languages), 2)
  run G.blob(&mut out, "getlanguageKeys", Bytes.asSlice(&keys), false)
  run G.add(&mut out, "fn stringAt(data: &'static [u8], offsets: &'static [u8], index: usize) -> Option<string<'static>> {\n  if index >= offsets.length / 4 - 1 { return Option<string<'static>>.None }\n  let start = readScalar<u32>(Slice.view<u8>(offsets, index * 4, 4)) |> Option<u32>.unwrapOr(0)\n  let end = readScalar<u32>(Slice.view<u8>(offsets, index * 4 + 4, 4)) |> Option<u32>.unwrapOr(0)\n  return match move String.fromUtf8(Slice.view<u8>(data, u32.toUsize(start), u32.toUsize(end - start))) { Result<string<'static>, InvalidUtf8>.Success { value } => Option<string<'static>>.some(value) Result<string<'static>, InvalidUtf8>.Failure { error } => Option<string<'static>>.None }\n}\npub const POST_NAME_COUNT: usize = 258\npub fn postName(index: usize) -> Option<string<'static>> { return stringAt(getpostNamesData(), getpostNamesOffsets(), index) }\npub fn macRomanCode(index: usize) -> Option<u16> {\n  if index >= 128 { return Option<u16>.None }\n  return readScalar<u16>(Slice.view<u8>(getmacRomanData(), index * 2, 2))\n}\npub fn languageIdToBcp47(platformId: u16, languageId: u16) -> Option<string<'static>> {\n  if !((platformId == 1 && languageId <= 151) || (platformId == 3 && languageId >= 1025)) { return Option<string<'static>>.None }\n  let mut low: usize = 0\n  let mut high = getlanguageKeys().length / 2\n  while low < high {\n    let mid = low + (high - low) / 2\n    let key = readScalar<u16>(Slice.view<u8>(getlanguageKeys(), mid * 2, 2)) |> Option<u16>.unwrapOr(0)\n    if key <= languageId { low = mid + 1 } else { high = mid }\n  }\n  if low > 0 {\n    let index = low - 1\n    let key = readScalar<u16>(Slice.view<u8>(getlanguageKeys(), index * 2, 2)) |> Option<u16>.unwrapOr(0)\n    if key == languageId { return stringAt(getlanguagesData(), getlanguagesOffsets(), index) }\n  }\n  return Option<string<'static>>.None\n}\npub struct Os2UnicodeRange { pub first: u32, pub last: u32, pub bit: u8, }\nimpl Copy for Os2UnicodeRange {}\npub const OS2_UNICODE_RANGES: [Os2UnicodeRange; 169] = [\n")
  let rangeSlice = List<Match>.asSlice(&ranges) let mut rangeIndex: usize = 0
  while rangeIndex < rangeSlice.length {
    let entry = &rangeSlice[rangeIndex] rangeIndex = rangeIndex + 1
    run G.add(&mut out, "  Os2UnicodeRange { first: ") run G.decimal(&mut out, run G.number(G.group(entry, 1)))
    run G.add(&mut out, ", last: ") run G.decimal(&mut out, run G.number(G.group(entry, 2)))
    run G.add(&mut out, ", bit: ") run G.decimal(&mut out, run G.number(G.group(entry, 3))) run G.add(&mut out, " },\n")
  }
  run G.add(&mut out, "]\n") run G.save(root, "modules/parse/src/generated_data.silk", &out, check)
  run G.report(check, "packed static data")
  let base = run Path.resolve(root, directory) let source = run G.read(&base, "mvar.rs")
  let tags = run G.matches("pub const (\\w+): Tag = Tag::new\\(b\"(.{4})\"\\);", run G.text(Bytes.asSlice(&source)))
  run G.require(List<Match>.length(&tags) == 38, "Expected 38 MVAR tags")
  let mut tagOut = Bytes.make()
  run G.add(&mut tagOut, "// THIS FILE IS AUTOGENERATED by silk task generate-static. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\nimport font_types.lib { Tag }\n")
  let tagSlice = List<Match>.asSlice(&tags) let mut tagIndex: usize = 0
  while tagIndex < tagSlice.length {
    let entry = &tagSlice[tagIndex] tagIndex = tagIndex + 1
    run G.add(&mut tagOut, "pub fn ")
    let name = String.utf8Bytes(G.group(entry, 1)) let mut i: usize = 0
    while i < name.length { let c = name[i] i = i + 1 let mut lower = c if c >= 65 && c <= 90 { lower = c + 32 } run Bytes.append(&mut tagOut, &[lower]) }
    run G.add(&mut tagOut, "() -> Tag { return Tag.fromU32(")
    run G.decimal(&mut tagOut, G.numberAt(String.utf8Bytes(G.group(entry, 2)), 0, 4)) run G.add(&mut tagOut, ") }\n")
  }
  run G.save(root, "modules/parse/src/tables/mvar/tags.silk", &tagOut, check)
}
