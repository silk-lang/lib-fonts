import font_generate_support as G
import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.regex { Match }
import silk.text.string { String }
import silk.io.writer { WriterError }

pub effect fn modelTables(root: &Path, check: bool) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let providerBytes = run G.read(root, "modules/parse/src/table_provider.silk")
  let provider = run G.text(Bytes.asSlice(&providerBytes))
  let source = run G.read(
    root,
    "modules/parse/upstream/read-fonts/data/generated/generated_tables.rs",
  )
  let tags = run G.matches(
    "f\\(Tag::new\\(b\"(.{4})\"\\), &mut self\\.(\\w+)\\);",
    run G.text(Bytes.asSlice(&source)),
  )
  run G.require(List<Match>.length(&tags) > 50, "Expected more than 50 model table tags")
  let imports = run G.matches("(?m:^import [^\\n]*)", provider)
  let mut out = Bytes.make()
  run G.add(&mut out, "// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n")
  let importSlice = List<Match>.asSlice(&imports)
  let mut importIndex: usize = 0
  while importIndex < importSlice.length {
    let item = &importSlice[importIndex]
    importIndex = importIndex + 1
    run G.add(&mut out, G.group(item, 0))
    run G.add(&mut out, "\n")
  }
  run G.add(&mut out, "pub const MODEL_TABLE_TAGS: [u32; ")
  run G.decimal(&mut out, List<Match>.length(&tags))
  run G.add(&mut out, "] = [")
  let mut first = true
  let tagSlice = List<Match>.asSlice(&tags)
  let mut tagIndex: usize = 0
  while tagIndex < tagSlice.length {
    let item = &tagSlice[tagIndex]
    tagIndex = tagIndex + 1
    if !first {
      run G.add(&mut out, ",")
    }
    first = false
    run G.decimal(&mut out, G.numberAt(String.utf8Bytes(G.group(item, 1)), 0, 4))
  }
  run G.add(&mut out, "]\n")
  let implementation = run G.read(root, "modules/parse/src/model/font/tables_impl.silk")
  run Bytes.append(&mut out, Bytes.asSlice(&implementation))
  let body = run G.before(
    run G.after(provider, "pub interface TableProvider"),
    "impl<'a> TableProvider",
  )
  let methods = run G.matches(
    "\\bfn (\\w+)\\(self:\\s*&Self([^)]*)\\)\\s*->\\s*(Result<[^\\n{]+>)\\s*\\{",
    body,
  )
  run G.require(List<Match>.length(&methods) >= 40, "Expected at least 40 TableProvider methods")
  run G.add(
    &mut out,
    "\nimpl<'a> TableProvider<'a> for TablesView<'a> {\n  fn dataForTag(self:&Self,tag:Tag) -> Option<FontData<'a>> { return Option<FontData<'a>>.None }\n",
  )
  let methodSlice = List<Match>.asSlice(&methods)
  let mut methodIndex: usize = 0
  while methodIndex < methodSlice.length {
    let item = &methodSlice[methodIndex]
    methodIndex = methodIndex + 1
    let name = G.group(item, 1)
    if name == "expectDataForTag" {
      continue
    }
    let extra = G.group(item, 2)
    let result = G.group(item, 3)
    run G.add(&mut out, "  fn ")
    run G.add(&mut out, name)
    run G.add(&mut out, "(self:&Self")
    run G.add(&mut out, extra)
    run G.add(&mut out, ") -> ")
    run G.add(&mut out, result)
    run G.add(
      &mut out,
      " { let raw=RawTables<'a> { tables:self.tables } return validated(TableProvider.",
    )
    run G.add(&mut out, name)
    run G.add(&mut out, "(&raw")
    run arguments(&mut out, extra)
    run G.add(&mut out, ")) }\n")
  }
  run G.add(&mut out, "}\nimpl Tables {\n")
  methodIndex = 0
  while methodIndex < methodSlice.length {
    let item = &methodSlice[methodIndex]
    methodIndex = methodIndex + 1
    let name = G.group(item, 1)
    if name == "expectDataForTag" {
      continue
    }
    let extra = G.group(item, 2)
    let result = G.group(item, 3)
    run G.add(&mut out, "  pub fn ")
    run G.add(&mut out, name)
    run G.add(&mut out, "<'a>(self:&'a Self")
    run G.add(&mut out, extra)
    run G.add(&mut out, ") -> ")
    run G.add(&mut out, result)
    run G.add(&mut out, " { let view=Tables.view(self) return TableProvider.")
    run G.add(&mut out, name)
    run G.add(&mut out, "(&view")
    run arguments(&mut out, extra)
    run G.add(&mut out, ") }\n")
  }
  tagIndex = 0
  while tagIndex < tagSlice.length {
    let item = &tagSlice[tagIndex]
    tagIndex = tagIndex + 1
    let raw = String.utf8Bytes(G.group(item, 2))
    let mut name = Bytes.make()
    let mut at: usize = 0
    while at < raw.length {
      if raw[at] == 95 && at + 1 < raw.length && raw[at + 1] >= 97 && raw[at + 1] <= 122 {
        run Bytes.append(&mut name, &[raw[at + 1] - 32])
        at = at + 2
      } else {
        run Bytes.append(&mut name, &[raw[at]])
        at = at + 1
      }
    }
    run G.add(&mut out, "  pub fn ")
    run Bytes.append(&mut out, Bytes.asSlice(&name))
    run G.add(
      &mut out,
      "Data<'a>(self:&'a Self) -> Option<&'a [u8]> { return match move Tables.rawData(self,Tag.fromU32(",
    )
    run G.decimal(&mut out, G.numberAt(String.utf8Bytes(G.group(item, 1)), 0, 4))
    run G.add(
      &mut out,
      ")) { Option<FontData<'a>>.Some { value }=>Option<&'a [u8]>.some(FontData.asBytes(&value)) _=>Option<&'a [u8]>.None } }\n",
    )
  }
  run G.add(&mut out, "}\n")
  run G.save(root, "modules/parse/src/generated_model_tables.silk", &out, check)
  let facade = run Bytes.copy(
    b"// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\npub import generated_model_tables { Tables,TablesView,TableFunction,TableCallback }\n",
  )
  run G.save(root, "modules/parse/src/model/font/tables.silk", &facade, check)
  let mut message = Bytes.make()
  run G.add(&mut message, "model table forwarding (")
  run G.decimal(&mut message, List<Match>.length(&tags))
  run G.add(&mut message, " tags, ")
  run G.decimal(&mut message, List<Match>.length(&methods) - 1)
  run G.add(&mut message, " methods)")
  run G.report(check, run G.text(Bytes.asSlice(&message)))
}

effect fn arguments(out: &mut Bytes, extra: string) -> ()
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let names = run G.matches(",\\s*(\\w+):", extra)
  let items = List<Match>.asSlice(&names)
  let mut i: usize = 0
  while i < items.length {
    let item = &items[i]
    i = i + 1
    run G.add(&mut out, ",move ")
    run G.add(&mut out, G.group(item, 1))
  }
}
