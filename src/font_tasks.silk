import casefold
import color_fonts
import font_shape_generate_unicode { generateShapingUnicode }
import font_shape_generate_machines { generateShapingMachines }
import font_shape_generate_languages { generateShapingLanguages }
import font_shape_generate_fixtures { generateShapingFixtures }
import font_shape_generate_tests { generateShapingTests }
import font_generate
import font_generate_data
import font_generate_tables
import font_generate_fixtures
import font_generate_model
import font_generate_misc
import font_harness_corpus

static if Intrinsic.targetOperatingSystem() == "darwin"
  || Intrinsic.targetOperatingSystem() == "linux" {
  import font_harness
  import font_harness_shaping
  import font_harness_shape_checks
  import font_benchmark_shaping
  import font_benchmark_library
  import font_benchmark
  import font_harness_campaign
  import font_harness_robustness
  import font_harness_core_fixtures
  import font_harness_table_fixtures
  import font_harness_layout_fixtures
  import font_harness_variation_fixtures
  import font_harness_model_fixtures
  import font_harness_aat_fixtures
  import font_harness_cff_fixtures
  import font_harness_misc_fixtures
  import font_harness_tests
}

import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { InvalidUtf8, String }

pub union Tasks {
  GenerateCasefold { pub fetch: bool, pub update: bool },
  GenerateColorFonts,
  GenerateShapingUnicode,
  GenerateShapingMachines,
  GenerateShapingLanguages,
  GenerateShapingFixtures,
  GenerateShapingTests { pub check: bool },
  Generate { pub check: bool },
  GenerateStatic { pub check: bool },
  GeneratePsData { pub check: bool },
  GenerateModelTables { pub check: bool },
  GenerateModelFixtures { pub check: bool },
  GenerateMiscTableFixtures { pub check: bool },
  GenerateLayoutFixtures { pub check: bool },
  GenerateVariationFixtures { pub check: bool },
  GenerateAatFixtures { pub check: bool },
  GenerateCffFixtures { pub check: bool },
  Build { pub referenceOnly: bool, pub release: bool },
  BuildWasm,
  CheckWasm,
  Check,
  FontList { pub fonts: String, pub output: String, pub report: String, pub timeout: f64 },
  Compare {
    pub fonts: String,
    pub reference: String,
    pub silkDumper: String,
    pub timeout: f64,
    pub report: String
  },
  VerifyReference {
    pub fonts: String,
    pub reference: String,
    pub timeout: f64,
    pub report: String
  },
  CompareShaping { pub silk: String, pub rust: String, pub filter: String },
  CheckShapingTrace { pub binary: String },
  CheckShapingMalformed {
    pub binary: String,
    pub mutationsPerFont: usize,
    pub allFonts: bool,
    pub malformedTimeout: f64,
    pub failures: String
  },
  CheckShaping { pub noBuild: bool },
  BenchShaping {
    pub silk: String,
    pub rust: String,
    pub iterations: usize,
    pub samples: usize,
    pub filter: String,
    pub callgrind: bool
  },
  BenchLibrary {
    pub fonts: String,
    pub librarySilk: String,
    pub libraryRust: String,
    pub workload: List<String>,
    pub top: i64
  },
  Benchmark {
    pub fonts: String,
    pub benchmarkReference: String,
    pub benchmarkSilk: String,
    pub rounds: usize,
    pub longTimeout: f64,
    pub requiredReport: String
  },
  CheckMalformed {
    pub fonts: String,
    pub reference: String,
    pub silkDumper: String,
    pub seed: i64,
    pub jobs: Option<usize>,
    pub longTimeout: f64,
    pub cache: String,
    pub campaignFailures: String,
    pub requiredReport: String
  },
  CheckRobustness {
    pub fonts: String,
    pub silkDumper: String,
    pub robustnessMutations: usize,
    pub seed: i64,
    pub robustnessTimeout: f64,
    pub jobs: Option<usize>,
    pub robustnessFailures: String
  },
  CheckCoreFixtures,
  CheckTableFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckLayoutFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckVariationFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckModelFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckAatFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  CheckCffFixtures {
    pub reference: String,
    pub silkDumper: String,
    pub report: String,
    pub seedsOnly: bool
  },
  CheckMiscTableFixtures { pub reference: String, pub silkDumper: String, pub report: String },
  TestHarness,
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.GenerateCasefold { fetch, update } => run casefold.generate(fetch, update)
      Tasks.GenerateColorFonts => run color_fonts.generate()
      Tasks.GenerateShapingUnicode => {
        let root = run Task.root()
        run generateShapingUnicode(&root)
      }
      Tasks.GenerateShapingMachines => {
        let root = run Task.root()
        run generateShapingMachines(&root)
      }
      Tasks.GenerateShapingLanguages => {
        let root = run Task.root()
        run generateShapingLanguages(&root)
      }
      Tasks.GenerateShapingFixtures => {
        let root = run Task.root()
        run generateShapingFixtures(&root)
      }
      Tasks.GenerateShapingTests { check } => {
        let root = run Task.root()
        run generateShapingTests(&root, check)
      }
      Tasks.Generate { check } => {
        let root = run Task.root()
        run font_generate.generate(&root, check)
      }
      Tasks.GenerateStatic { check } => {
        let root = run Task.root()
        run font_generate_data.naming(&root, check)
      }
      Tasks.GeneratePsData { check } => {
        let root = run Task.root()
        run font_generate_data.postscript(&root, check)
      }
      Tasks.GenerateModelTables { check } => {
        let root = run Task.root()
        run font_generate_tables.modelTables(&root, check)
      }
      Tasks.GenerateModelFixtures { check } => {
        let root = run Task.root()
        run font_generate_model.model(&root, check)
      }
      Tasks.GenerateMiscTableFixtures { check } => {
        let root = run Task.root()
        run font_generate_misc.misc(&root, check)
      }
      Tasks.GenerateLayoutFixtures { check } => {
        let root = run Task.root()
        run font_generate_fixtures.layout(&root, check)
      }
      Tasks.GenerateVariationFixtures { check } => {
        let root = run Task.root()
        run font_generate_fixtures.variation(&root, check)
      }
      Tasks.GenerateAatFixtures { check } => {
        let root = run Task.root()
        run font_generate_fixtures.aat(&root, check)
      }
      Tasks.GenerateCffFixtures { check } => {
        let root = run Task.root()
        run font_generate_fixtures.cff(&root, check)
      }
      Tasks.Build { referenceOnly, release } => run build(referenceOnly, release)
      Tasks.BuildWasm => run buildWasm()
      Tasks.CheckWasm => {
        run Task.silk(
          &[
            "check",
            "--manifest-path",
            "modules/shape/tools/wasm/silk.toml",
            "--target",
            "wasm32-unknown-unknown",
          ],
        )
        run Task.silk(
          &[
            "build",
            "--release",
            "--manifest-path",
            "modules/shape/tools/wasm/silk.toml",
            "--target",
            "wasm32-unknown-unknown",
          ],
        )
      }
      Tasks.Check => run check()
      Tasks.FontList { fonts, output, report, timeout } => {
        run font_harness_corpus.fontList(
          String.view(&fonts),
          String.view(&output),
          String.view(&report),
          timeout,
        )
      }
      Tasks.Compare { fonts, reference, silkDumper, timeout, report } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness.compare(
            String.view(&fonts),
            String.view(&reference),
            String.view(&silkDumper),
            timeout,
            String.view(&report),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.VerifyReference { fonts, reference, timeout, report } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness.verifyReference(
            String.view(&fonts),
            String.view(&reference),
            timeout,
            String.view(&report),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CompareShaping { silk, rust, filter } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_shape_checks.compareShaping(
            String.view(&silk),
            String.view(&rust),
            String.view(&filter),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckShapingTrace { binary } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_shaping.checkShapingTrace(String.view(&binary))
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckShapingMalformed {
        binary,
        mutationsPerFont,
        allFonts,
        malformedTimeout,
        failures
      } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_shape_checks.checkShapingMalformed(
            String.view(&binary),
            mutationsPerFont,
            allFonts,
            malformedTimeout,
            String.view(&failures),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckShaping { noBuild } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_shape_checks.checkShaping(noBuild)
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.BenchShaping { silk, rust, iterations, samples, filter, callgrind } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_benchmark_shaping.benchShaping(
            String.view(&silk),
            String.view(&rust),
            iterations,
            samples,
            String.view(&filter),
            callgrind,
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.BenchLibrary { fonts, librarySilk, libraryRust, workload, top } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_benchmark_library.benchLibrary(
            String.view(&fonts),
            String.view(&librarySilk),
            String.view(&libraryRust),
            List<String>.asSlice(&workload),
            top,
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.Benchmark {
        fonts,
        benchmarkReference,
        benchmarkSilk,
        rounds,
        longTimeout,
        requiredReport
      } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_benchmark.benchmark(
            String.view(&fonts),
            String.view(&benchmarkReference),
            String.view(&benchmarkSilk),
            rounds,
            longTimeout,
            String.view(&requiredReport),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckMalformed {
        fonts,
        reference,
        silkDumper,
        seed,
        jobs,
        longTimeout,
        cache,
        campaignFailures,
        requiredReport
      } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_campaign.checkMalformed(
            String.view(&fonts),
            String.view(&reference),
            String.view(&silkDumper),
            seed,
            run workers(move jobs),
            longTimeout,
            String.view(&cache),
            String.view(&campaignFailures),
            String.view(&requiredReport),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckRobustness {
        fonts,
        silkDumper,
        robustnessMutations,
        seed,
        robustnessTimeout,
        jobs,
        robustnessFailures
      } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_robustness.checkRobustness(
            String.view(&fonts),
            String.view(&silkDumper),
            robustnessMutations,
            seed,
            robustnessTimeout,
            run workers(move jobs),
            String.view(&robustnessFailures),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckCoreFixtures => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_core_fixtures.checkCoreFixtures()
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckTableFixtures { reference, silkDumper, report } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_table_fixtures.checkTableFixtures(
            String.view(&reference),
            String.view(&silkDumper),
            String.view(&report),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckLayoutFixtures { reference, silkDumper, report } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_layout_fixtures.checkLayoutFixtures(
            String.view(&reference),
            String.view(&silkDumper),
            String.view(&report),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckVariationFixtures { reference, silkDumper, report } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_variation_fixtures.checkVariationFixtures(
            String.view(&reference),
            String.view(&silkDumper),
            String.view(&report),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckModelFixtures { reference, silkDumper, report } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_model_fixtures.checkModelFixtures(
            String.view(&reference),
            String.view(&silkDumper),
            String.view(&report),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckAatFixtures { reference, silkDumper, report } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_aat_fixtures.checkAatFixtures(
            String.view(&reference),
            String.view(&silkDumper),
            String.view(&report),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckCffFixtures { reference, silkDumper, report, seedsOnly } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_cff_fixtures.checkCffFixtures(
            String.view(&reference),
            String.view(&silkDumper),
            String.view(&report),
            seedsOnly,
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.CheckMiscTableFixtures { reference, silkDumper, report } => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_misc_fixtures.checkMiscTableFixtures(
            String.view(&reference),
            String.view(&silkDumper),
            String.view(&report),
          )
        } else {
          run unsupportedHarness()
        }
      }
      Tasks.TestHarness => {
        static if Intrinsic.targetOperatingSystem() == "darwin"
          || Intrinsic.targetOperatingSystem() == "linux" {
          run font_harness_tests.checkHarness()
        } else {
          run unsupportedHarness()
        }
      }
    }
  }
}

effect fn unsupportedHarness() -> never
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  return run Task.abort(
    "managed font harness tasks require Linux or macOS; Windows support is blocked by silk#3034",
  )
}

effect fn workers(option: Option<usize>) -> usize
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  return match move option {
    Option<usize>.None => 0
    Option<usize>.Some { value } => {
      if value == 0 {
        run Task.abort("--jobs must be positive")
      }
      value
    }
  }
}

effect fn build(referenceOnly: bool, release: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let cargo = match move run HostInput.variableNamed("CARGO") {
    Option<Bytes>.Some { value } => run String.copy(run text(Bytes.asSlice(&value)))
    Option<Bytes>.None => run String.copy("cargo")
  }
  if release {
    run Task.exec(
      String.view(&cargo),
      &[
        "build",
        "--locked",
        "--manifest-path",
        "modules/scripts/rust-font-dump/Cargo.toml",
        "--target-dir",
        "build/rust",
        "--release",
      ],
    )
  } else {
    run Task.exec(
      String.view(&cargo),
      &[
        "build",
        "--locked",
        "--manifest-path",
        "modules/scripts/rust-font-dump/Cargo.toml",
        "--target-dir",
        "build/rust",
      ],
    )
  }
  if !referenceOnly {
    if release {
      run Task.silk(&["build", "--manifest-path", "font-parse-test-harness/silk.toml", "--release"])
      run Task.silk(&["build", "--manifest-path", "modules/parse/bench/silk.toml", "--release"])
    } else {
      run Task.silk(&["build", "--manifest-path", "font-parse-test-harness/silk.toml"])
      run Task.silk(&["build", "--manifest-path", "modules/parse/bench/silk.toml"])
    }
  }
}

effect fn check() -> ()
  ! TaskError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  run Task.silk(&["check", "--workspace"])
  let packages = [
    "modules/types/silk.toml",
    "modules/parse/silk.toml",
    "modules/shape/silk.toml",
    "modules/outline/silk.toml",
    "modules/raster/silk.toml",
    "modules/faces/silk.toml",
    "modules/web/silk.toml",
  ]
  let mut at: usize = 0
  while at < packages.length {
    run Task.silk(&["test", "--manifest-path", packages[at], "--root", "src/tests.silk"])
    at = at + 1
  }
  run Task.silk(&["build", "--package", "font-parse-test-harness"])
  run Task.silk(&["build", "--package", "font-shape-test-harness"])
  run Task.silk(&["build", "--package", "font-parse-bench"])
}

effect fn buildWasm() -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  run Task.silk(
    &[
      "build",
      "--release",
      "--manifest-path",
      "modules/shape/tools/wasm/silk.toml",
      "--target",
      "wasm32-unknown-unknown",
    ],
  )
  let root = run Task.root()
  let artifact = run Path.join(&root, "build/llvm/wasm32-unknown-unknown/release/font-shape-wasm")
  let destination = run Path.join(&root, "modules/shape/tools/wasm/js/dist/harfrust.wasm")
  let bytes = run FileSystem.readFile(&artifact)
  run FileSystem.writeFileWithParents(&destination, Bytes.asSlice(&bytes))
  let mut stdout = StdoutWriter.make()
  run Writer.writeAll(Path.rawBytes(&destination)) |> Effect.provideMut<Writer>(&mut stdout)
  run Writer.writeAll(b"\n") |> Effect.provideMut<Writer>(&mut stdout)
}

effect fn text(bytes: &[u8]) -> string
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  return match move String.fromUtf8(bytes) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { .. } => run Task.abort("expected UTF-8 process output")
  }
}
