import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.system.filesystem { FileError, FileSystem, Path, FileInfo, DirectoryInfo }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String, InvalidUtf8 }
import silk.num.usize
import silk.num.u8
import silk.core.order { Order, Ordering }
import font_harness_process as Process

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_path as WindowsHostPath
  import silk.platform.windows.path { WindowsPath }
  unsafe extern "C" fn _wfopen(path: ?[*]const u16, mode: ?[*]const u16) -> ?*mut u8
} else {
  import silk.platform.native.file { NativeFile, NativeFileError }
  unsafe extern "C" fn fopen(path: ?[*]const u8, mode: ?[*]const u8) -> ?*mut u8
}
unsafe extern "C" fn fread(bytes: ?[*]mut u8, size: usize, count: usize, file: *mut u8) -> usize
unsafe extern "C" fn fclose(file: *mut u8) -> i32

pub struct Corpus { pub fonts: List<String>, pub inventory: Bytes, pub excluded: usize }

pub effect fn utf8(bytes: &[u8]) -> String ! TaskError | OutOfMemoryError ? &mut Allocator {
  match String.fromUtf8(bytes) {
    Result<string, InvalidUtf8>.Success { value } => { return run String.copy(value) }
    Result<string, InvalidUtf8>.Failure { .. } => run Task.abort("expected UTF-8 text")
  }
}

pub effect fn pathText(path: &Path) -> String ! TaskError | OutOfMemoryError ? &mut Allocator {
  return run utf8(Path.rawBytes(path))
}

pub effect fn resolve(value: string) -> Path ! TaskError | HostInputError | FileError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let root = run Task.root()
  static if Intrinsic.targetOperatingSystem() == "windows" { return run WindowsPath.resolve(&root, value) }
  else {
    if String.startsWith(value, "/") { return run Path.make(value) }
    return run Path.resolve(&root, value)
  }
}

pub effect fn absolute(value: string) -> String ! TaskError | HostInputError | FileError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let path = run resolve(value)
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let canonical = match move run WindowsHostPath.canonicalBytes(Path.rawBytes(&path)) {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => run Task.abort("cannot resolve font path")
    }
    return run utf8(canonical.asSlice())
  } else {
    let mut buffer: [u8; 4096] = [0; 4096]
    let count = match move run Effect.result(NativeFile.realPath(Path.rawBytes(&path), &mut buffer)) {
      Result<usize, NativeFileError>.Success { value: length } => length
      Result<usize, NativeFileError>.Failure { .. } => run Task.abort("cannot resolve font path")
    }
    return run utf8(Slice.view<u8>(&buffer, 0, count))
  }
}

pub fn display<'a>(root: &'a Path, path: &'a String) -> string<'a> {
  let base = Path.rawBytes(root)
  let bytes = String.utf8Bytes(String.view(path))
  if bytes.length > base.length && Process.equal(Slice.view<u8>(bytes, 0, base.length), base) && bytes[base.length] == 47 {
    return unsafe String.fromUtf8Unchecked(Slice.view<u8>(bytes, base.length + 1, bytes.length - base.length - 1))
  }
  return String.view(path)
}

pub effect fn quote(output: &mut Bytes, text: string) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut output, b"\"")
  let bytes = String.utf8Bytes(text)
  let hex = b"0123456789abcdef"
  let mut at: usize = 0
  while at < bytes.length {
    let c = bytes[at]
    if c == 34 || c == 92 { run Bytes.append(&mut output, b"\\") }
    if c < 32 {
      let escape: [u8; 6] = [92, 117, 48, 48, hex[u8.toUsize(c / 16)], hex[u8.toUsize(c % 16)]]
      run Bytes.append(&mut output, &escape)
    } else { run Bytes.append(&mut output, Slice.view<u8>(bytes, at, 1)) }
    at = at + 1
  }
  run Bytes.append(&mut output, b"\"")
}

pub effect fn appendNumber(output: &mut Bytes, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let text = run Process.number(usize.toU64(count))
  run Bytes.append(&mut output, String.utf8Bytes(String.view(&text)))
}

pub effect fn save(name: string, contents: &[u8]) -> ()
  ! TaskError | HostInputError | FileError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let path = run resolve(name)
  run FileSystem.writeFileWithParents(&path, contents)
}

fn suffixFont(path: string) -> bool {
  let bytes = String.utf8Bytes(path)
  let suffixes = [b".ttf", b".otf", b".ttc", b".otc", b".dfont", b".woff", b".woff2"]
  let mut at: usize = 0
  while at < suffixes.length {
    let suffix = suffixes[at]
    if bytes.length >= suffix.length {
      let mut matches = true
      let mut k: usize = 0
      while k < suffix.length {
        let mut c = bytes[bytes.length - suffix.length + k]
        if c >= 65 && c <= 90 { c = c + 32 }
        if c != suffix[k] { matches = false }
        k = k + 1
      }
      if matches { return true }
    }
    at = at + 1
  }
  return false
}

effect fn hasMagic(path: &Path) -> bool ! TaskError | OutOfMemoryError ? &mut Allocator {
  let raw = run openRead(path)
  let handle = match Pointer.nonNullMut(raw) {
    Option<*mut u8>.Some { value } => value
    Option<*mut u8>.None => run Task.abort("cannot read corpus file")
  }
  let mut magic: [u8; 4] = [0; 4]
  let count = unsafe fread(Pointer.fromMutSlice(&mut magic), 1, 4, handle)
  let _closed = unsafe fclose(handle)
  return count == 4 && (Process.equal(&magic, b"\x00\x01\x00\x00") || Process.equal(&magic, b"OTTO") || Process.equal(&magic, b"true") || Process.equal(&magic, b"ttcf"))
}

effect fn openRead(path: &Path) -> ?*mut u8 ! TaskError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let wide = match move run WindowsHostPath.wide(path) {
      Option<List<u16>>.Some { value } => move value
      Option<List<u16>>.None => run Task.abort("invalid Windows font path")
    }
    let mode: [u16; 3] = [114, 98, 0]
    return unsafe _wfopen(Pointer.fromSlice(wide.asSlice()), Pointer.fromSlice(&mode))
  } else {
    let mut text = run Bytes.copy(Path.rawBytes(path))
    run text.append(b"\x00")
    return unsafe fopen(Pointer.fromSlice(text.asSlice()), Pointer.fromSlice(b"rb\x00"))
  }
}

effect fn walk(directory: &Path, found: &mut List<String>, excluded: &mut List<String>) -> ()
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let entries = run FileSystem.listDirectory(directory)
  let items = entries.asSlice()
  let mut at: usize = 0
  while at < items.length {
    let entry = &items[at]
    if entry.kind.code == 1 {
      run walk(&entry.path, &mut found, &mut excluded)
    } else {
      let info = run FileSystem.stat(&entry.path)
      if let FileInfo file = move info {
        drop file
        let name = run pathText(&entry.path)
        // Read the magic even for named containers, as the original discovery does.
        let magic = run hasMagic(&entry.path)
        if suffixFont(String.view(&name)) || magic { run found.append(move name) }
        else { run excluded.append(move name) }
      }
    }
    at = at + 1
  }
}

pub effect fn load(listing: string) -> Corpus
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = run Task.root()
  let mut fonts = List<String>.make()
  let mut inventory = run Bytes.copy(b"[")
  let mut excludedCount: usize = 0
  if listing != "" {
    let path = run resolve(listing)
    let data = run FileSystem.readFile(&path)
    let checked = run utf8(Bytes.asSlice(&data))
    let bytes = String.utf8Bytes(String.view(&checked))
    let mut start: usize = 0
    while start < bytes.length {
      let mut end = start
      while end < bytes.length && bytes[end] != 10 && bytes[end] != 13 { end = end + 1 }
      if end > start && bytes[start] != 35 {
        let line = unsafe String.fromUtf8Unchecked(Slice.view<u8>(bytes, start, end - start))
        let name = run absolute(line)
        let path = run Path.make(String.view(&name))
        match move run FileSystem.stat(&path) {
          FileInfo _ => {}
          DirectoryInfo _ => run Task.abort("font list names a missing file")
        }
        let previous = fonts.asSlice()
        let mut at: usize = 0
        while at < previous.length {
          if String.view(&previous[at]) == String.view(&name) { run Task.abort("font list contains duplicates") }
          at = at + 1
        }
        run fonts.append(move name)
      }
      start = end + 1
    }
    if fonts.length() == 0 { run Task.abort("font list is empty") }
  } else {
    let roots = ["modules/parse/upstream/font-test-data/test_data/ttf", "modules/parse/upstream/font-test-data/test_data/ttc", "modules/parse/upstream/font-test-data/test_data/extracted", "modules/shape/test-data/harfrust/harfrust/tests/fonts"]
    let mut at: usize = 0
    while at < roots.length {
      let directory = run Path.join(&root, roots[at])
      if !run FileSystem.exists(&directory) { run Task.abort("missing corpus; run git submodule update --init --recursive") }
      let mut found = List<String>.make()
      let mut excluded = List<String>.make()
      run walk(&directory, &mut found, &mut excluded)
      if found.length() == 0 && at != 2 { run Task.abort("empty font corpus") }
      sortStrings(excluded.asMutSlice())
      if at != 0 { run Bytes.append(&mut inventory, b",") }
      run Bytes.append(&mut inventory, b"{\"root\":")
      run quote(&mut inventory, roots[at])
      run Bytes.append(&mut inventory, b",\"fonts\":")
      run appendNumber(&mut inventory, found.length())
      run Bytes.append(&mut inventory, b",\"excluded\":[")
      let exclusions = excluded.asSlice()
      let mut k: usize = 0
      while k < exclusions.length {
        if k != 0 { run Bytes.append(&mut inventory, b",") }
        run quote(&mut inventory, display(&root, &exclusions[k]))
        k = k + 1
      }
      excludedCount = excludedCount + excluded.length()
      run Bytes.append(&mut inventory, b"]}")
      while let Option<String>.Some { value } = move found.pop() { run fonts.append(move value) }
      at = at + 1
    }
    sortStrings(fonts.asMutSlice())
  }
  run Bytes.append(&mut inventory, b"]\n")
  return Corpus { fonts: move fonts, inventory: move inventory, excluded: excludedCount }
}

pub effect fn fontList(fonts: string, output: string, report: string, timeout: f64) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  if timeout <= 0.0 { run Task.abort("timeout must be positive") }
  let corpus = run load(fonts)
  let root = run Task.root()
  let mut listing = Bytes.make()
  let entries = corpus.fonts.asSlice()
  let mut at: usize = 0
  while at < entries.length {
    run Bytes.append(&mut listing, String.utf8Bytes(display(&root, &entries[at])))
    run Bytes.append(&mut listing, b"\n")
    at = at + 1
  }
  if output == "" { run Process.print(Bytes.asSlice(&listing)) } else { run save(output, Bytes.asSlice(&listing)) }
  if report != "" { run save(report, Bytes.asSlice(&corpus.inventory)) }
  let mut summary = Bytes.make()
  run appendNumber(&mut summary, entries.length)
  run Bytes.append(&mut summary, b" fonts; ")
  run appendNumber(&mut summary, corpus.excluded)
  run Bytes.append(&mut summary, b" non-font files excluded\n")
  run Process.error(Bytes.asSlice(&summary))
}

fn swap(values: &mut [String], left: usize, right: usize) -> () {
  if left == right { return }
  let first = Intrinsic.replace(values[left], String.make())
  let second = Intrinsic.replace(values[right], move first)
  values[left] = move second
}

fn sift(values: &mut [String], root: usize, size: usize) -> () {
  let mut parent = root
  while parent < size / 2 {
    let mut child = parent * 2 + 1
    if child + 1 < size && Order.compare(&String.view(&values[child]), &String.view(&values[child + 1])) == Ordering.Less { child = child + 1 }
    if Order.compare(&String.view(&values[parent]), &String.view(&values[child])) != Ordering.Less { return }
    swap(&mut values, parent, child)
    parent = child
  }
}

pub fn sortStrings(values: &mut [String]) -> () {
  let mut parent = values.length / 2
  let length = values.length
  while parent > 0 { parent = parent - 1  sift(&mut values, parent, length) }
  let mut size = values.length
  while size > 1 { size = size - 1  swap(&mut values, 0, size)  sift(&mut values, 0, size) }
}
