import font_shape_generate_common as G
import font_shape_generate_common { Hit }
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value, JsonEntry }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, FileInfo, DirectoryInfo, Path }
import silk.text.string { String, InvalidUtf8 }
import silk.num.u8
import silk.num.u64
import silk.num.usize

pub struct ShapingCase {
  pub name: String,
  pub font: String,
  pub text: String,
  pub options: String,
  pub expected: String,
}

effect fn jsonFailure(error: JsonError) -> never ! TaskError | OutOfMemoryError ? &mut Allocator {
  drop error
  return run Task.abort("invalid differential regression JSON")
}
effect fn scalar(out: &mut Bytes, cp: u64) -> () ! TaskError | OutOfMemoryError ? &mut Allocator {
  run G.require(cp <= 0x10ffff && !(cp >= 0xd800 && cp <= 0xdfff), "invalid Rust Unicode scalar")
  if cp < 128 { run G.integer(&mut out, cp, 1) }
  else if cp < 2048 {
    run G.integer(&mut out, 192 | (u64.shiftRight(cp, 6)), 1)
    run G.integer(&mut out, 128 | (cp & 63), 1)
  } else if cp < 65536 {
    run G.integer(&mut out, 224 | (u64.shiftRight(cp, 12)), 1)
    run G.integer(&mut out, 128 | ((u64.shiftRight(cp, 6)) & 63), 1)
    run G.integer(&mut out, 128 | (cp & 63), 1)
  } else {
    run G.integer(&mut out, 240 | (u64.shiftRight(cp, 18)), 1)
    run G.integer(&mut out, 128 | ((u64.shiftRight(cp, 12)) & 63), 1)
    run G.integer(&mut out, 128 | ((u64.shiftRight(cp, 6)) & 63), 1)
    run G.integer(&mut out, 128 | (cp & 63), 1)
  }
}
effect fn rustString(literal: string) -> String ! TaskError | OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(literal)
  let mut out = Bytes.make()
  let mut at: usize = 1
  while at + 1 < bytes.length {
    let c = bytes[at]
    at = at + 1
    if c != 92 { run Bytes.append(&mut out, &[c]) }
    else {
      run G.require(at + 1 < bytes.length, "truncated Rust escape")
      let escape = bytes[at]
      at = at + 1
      if escape == 10 {
        let rest = String.slice(literal, at, bytes.length - at)
        let trimmed = String.trimStart(rest)
        at = at + String.byteLength(rest) - String.byteLength(trimmed)
      } else if escape == 117 {
        run G.require(bytes[at] == 123, "invalid Rust Unicode escape")
        at = at + 1
        let end = at + run G.index(String.slice(literal, at, bytes.length - at), "}")
        let mut hex = run String.copy("0x")
        run String.append(&mut hex, String.slice(literal, at, end - at))
        run scalar(&mut out, run G.number(String.view(&hex)))
        at = end + 1
      } else if escape == 120 {
        run G.require(at + 2 < bytes.length, "truncated Rust byte escape")
        let mut hex = run String.copy("0x")
        run String.append(&mut hex, String.slice(literal, at, 2))
        run scalar(&mut out, run G.number(String.view(&hex)))
        at = at + 2
      } else {
        let mut decoded: u8 = 0
        if escape == 110 { decoded = 10 }
        else if escape == 114 { decoded = 13 }
        else if escape == 116 { decoded = 9 }
        else if escape == 98 { decoded = 8 }
        else if escape == 102 { decoded = 12 }
        else if escape == 48 { decoded = 0 }
        else if escape == 34 || escape == 92 || escape == 47 { decoded = escape }
        else { run Task.abort("unsupported Rust escape") }
        run Bytes.append(&mut out, &[decoded])
      }
    }
  }
  match move String.fromBytes(move out) {
    Result<String, InvalidUtf8>.Success { value } => { return move value }
    Result<String, InvalidUtf8>.Failure { .. } => { return run Task.abort("invalid UTF-8 in Rust literal") }
  }
}
effect fn appendCase(rows: &mut List<ShapingCase>, name: string, font: string, text: string, options: string, expected: string) -> () ! OutOfMemoryError ? &mut Allocator {
  run List<ShapingCase>.append(&mut rows, ShapingCase { name: run String.copy(name), font: run String.copy(font), text: run String.copy(text), options: run String.copy(options), expected: run String.copy(expected) })
}
effect fn literalCases(rows: &mut List<ShapingCase>, module: string, source: string, smoke: bool) -> usize ! TaskError | OutOfMemoryError ? &mut Allocator {
  let stringPattern = "\"(?:[^\"\\\\]|\\\\(?s:.))*\""
  let mut pattern = run String.copy("fn (\\w+)\\(\\)\\s*\\{\\s*")
  if !smoke { run String.append(&mut pattern, "assert_eq!\\(\\s*(?:crate::)?") }
  run String.append(&mut pattern, "shape\\(\\s*(")
  run String.append(&mut pattern, stringPattern)
  run String.append(&mut pattern, "),\\s*(")
  run String.append(&mut pattern, stringPattern)
  run String.append(&mut pattern, "),\\s*(")
  run String.append(&mut pattern, stringPattern)
  run String.append(&mut pattern, "),?\\s*\\)")
  if !smoke {
    run String.append(&mut pattern, ",\\s*(")
    run String.append(&mut pattern, stringPattern)
    run String.append(&mut pattern, ")\\s*\\)")
  }
  run String.append(&mut pattern, ";\\s*\\}")
  let matches = run G.hits(String.view(&pattern), source)
  let found = List<Hit>.asSlice(&matches)
  let mut i: usize = 0
  while i < found.length {
    let mut name = run String.copy(module)
    run String.append(&mut name, "::")
    run String.append(&mut name, G.group(&found[i], 1))
    run List<ShapingCase>.append(&mut rows, ShapingCase {
      name: move name,
      font: run rustString(G.group(&found[i], 2)),
      text: run rustString(G.group(&found[i], 3)),
      options: run rustString(G.group(&found[i], 4)),
      expected: if smoke { String.make() } else { run rustString(G.group(&found[i], 5)) },
    })
    i = i + 1
  }
  return found.length
}

pub effect fn shapingCases(root: &Path) -> List<ShapingCase> ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let base = run Path.join(root, "modules/shape/test-data/harfrust/harfrust")
  let mut result = List<ShapingCase>.make()
  let modules = &["in_house", "aots", "text_rendering_tests", "custom", "regressions"]
  let mut i: usize = 0
  while i < modules.length {
    let mut path = run String.copy("tests/shaping/")
    run String.append(&mut path, modules[i])
    run String.append(&mut path, ".rs")
    let source = run G.read(&base, String.view(&path))
    let count = run literalCases(&mut result, modules[i], String.view(&source), false)
    let smoke = run literalCases(&mut result, modules[i], String.view(&source), true)
    if modules[i] != "regressions" {
      let tests = run G.hits("#\\[test\\]", String.view(&source))
      run G.require(count + smoke == List<Hit>.length(&tests), "unsupported upstream shaping test syntax")
    }
    i = i + 1
  }
  let suffixes = &["gsub", "gpos"]
  i = 0
  while i < suffixes.length {
    let mut j: usize = 0
    while j < 4 {
      let mut name = run String.copy("feature_variations::")
      run String.append(&mut name, suffixes[i])
      run String.append(&mut name, "_")
      run G.decimal(&mut name, usize.toU64(j))
      let options = if i == 0 { ["", "--variations=wght=1000", "--variations=wght=999", "--variations=wght=500"] } else { ["", "--variations=TEST=0", "--variations=TEST=0.125", "--variations=TEST=0.5"] }
      let mut option = run String.copy(options[j])
      run String.append(&mut option, " --no-glyph-names")
      run appendCase(&mut result, String.view(&name), if i == 0 { "tests/fonts/text-rendering-tests/AdobeVFPrototype-Subset.otf" } else { "tests/fonts/default-gpos-variations.ttf" }, if i == 0 { "$" } else { "A" }, String.view(&option), if j == 3 { "[1=0+510]" } else if i == 0 { "[2=0+560]" } else { "[1=0+600]" })
      j = j + 1
    }
    i = i + 1
  }
  let digestSuffixes = &["f1", "f2"]
  i = 0
  while i < digestSuffixes.length {
    let mut name = run String.copy("regressions::ligature_digest_")
    run String.append(&mut name, digestSuffixes[i])
    let mut font = run String.copy("tests/fonts/aots/gsub4_1_multiple_ligatures_")
    run String.append(&mut font, digestSuffixes[i])
    run String.append(&mut font, ".otf")
    run appendCase(&mut result, String.view(&name), String.view(&font), "\u{12}\u{15}", "--features=test --no-clusters --no-glyph-names --ned --show-flags --unsafe-to-concat", "[18#2|21@1500,0#2]")
    i = i + 1
  }
  let differential = run G.read(root, "modules/shape/tests/differential.json")
  let regressions = run Effect.catch<JsonError>(Json.parse(String.utf8Bytes(String.view(&differential))), jsonFailure)
  let entries = match &regressions {
    Value.Object { entries } => List<JsonEntry>.asSlice(&entries)
    _ => { return run Task.abort("differential regressions must be an object") }
  }
  let rows = List<ShapingCase>.asMutSlice(&mut result)
  let mut found: usize = 0
  i = 0
  while i < rows.length {
    if let Option<&Value>.Some { value } = move Json.field(&regressions, String.view(&rows[i].name)) {
      run G.require(String.ownedByteLength(&rows[i].expected) == 0, "upstream now supplies a differential expectation")
      rows[i].expected = run expectation(value)
      found = found + 1
    }
    let path = run Path.join(&base, String.view(&rows[i].font))
    run G.require(run FileSystem.exists(&path), "missing pinned shaping font")
    match move run FileSystem.stat(&path) {
      FileInfo info => { drop info }
      DirectoryInfo info => {
        drop info
        run Task.abort("pinned shaping font is not a regular file")
      }
    }
    i = i + 1
  }
  run G.require(found == entries.length, "stale differential regression names")
  let mut names = List<string>.make()
  i = 0
  while i < rows.length {
    run List<string>.append(&mut names, String.view(&rows[i].name))
    i = i + 1
  }
  run List<string>.sort(&mut names)
  let ordered = List<string>.asSlice(&names)
  i = 1
  while i < ordered.length {
    run G.require(ordered[i - 1] != ordered[i], "duplicate shaping case names")
    i = i + 1
  }
  drop names
  return move result
}

effect fn expectation(value: &Value) -> String ! TaskError | OutOfMemoryError ? &mut Allocator {
  let parts = match &value.* {
    Value.Array { values } => List<Value>.asSlice(&values)
    _ => { return run Task.abort("differential expectation must be an array") }
  }
  let mut result = String.make()
  let mut i: usize = 0
  while i < parts.length {
    match &parts[i] {
      Value.String { text } => { run String.append(&mut result, String.view(&text)) }
      Value.Array { values } => {
        let repeat = List<Value>.asSlice(&values)
        run G.require(repeat.length == 2, "invalid repeated differential expectation")
        let count = Json.asU64(Option<&Value>.some(&repeat[0])) |> Option<u64>.unwrapOr(18446744073709551615)
        let text = Json.asString(Option<&Value>.some(&repeat[1]))
        run G.require(count != 18446744073709551615, "invalid differential repetition count")
        match move text {
          Option<string>.Some { value: repeated } => {
            let mut j: u64 = 0
            while j < count {
              run String.append(&mut result, repeated)
              j = j + 1
            }
          }
          Option<string>.None => { run Task.abort("invalid differential repetition text") }
        }
      }
      _ => { run Task.abort("invalid differential expectation part") }
    }
    i = i + 1
  }
  return move result
}

pub effect fn encodeShapingCases(rows: &[ShapingCase]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut data = run Bytes.copy(b"HRS1")
  run G.integer(&mut data, usize.toU64(rows.length), 4)
  let mut i: usize = 0
  while i < rows.length {
    let fields = &[String.view(&rows[i].name), String.view(&rows[i].font), String.view(&rows[i].text), String.view(&rows[i].options), String.view(&rows[i].expected)]
    let mut j: usize = 0
    while j < fields.length {
      let bytes = String.utf8Bytes(fields[j])
      run G.integer(&mut data, usize.toU64(bytes.length), 4)
      run Bytes.append(&mut data, bytes)
      j = j + 1
    }
    i = i + 1
  }
  return move data
}

pub effect fn generateShapingTests(root: &Path, check: bool) -> () ! TaskError | FileError | OutOfMemoryError | WriterError ? &mut Allocator | &mut FileSystem {
  let cases = run shapingCases(root)
  let rows = List<ShapingCase>.asSlice(&cases)
  let data = run encodeShapingCases(rows)
  let path = run Path.join(root, "modules/shape/tests/shaping.bin")
  if check {
    run G.require(run FileSystem.exists(&path), "shaping fixture is stale; run silk task generate-shaping-tests")
    let previous = run FileSystem.readFile(&path)
    let old = Bytes.asSlice(&previous)
    let new = Bytes.asSlice(&data)
    run G.require(old.length == new.length, "shaping fixture is stale; run silk task generate-shaping-tests")
    let mut i: usize = 0
    while i < old.length {
      run G.require(old[i] == new[i], "shaping fixture is stale; run silk task generate-shaping-tests")
      i = i + 1
    }
  } else { run FileSystem.writeFileWithParents(&path, Bytes.asSlice(&data)) }
  let mut report = String.make()
  run G.decimal(&mut report, usize.toU64(rows.length))
  run String.append(&mut report, " shaping cases, ")
  run G.decimal(&mut report, usize.toU64(Bytes.length(&data)))
  run String.append(&mut report, " bytes; macOS system fonts excluded\n")
  let mut writer = StdoutWriter.make()
  run Writer.writeAll(String.utf8Bytes(String.view(&report))) |> Effect.provideMut<Writer>(&mut writer)
}
