import font_harness_text as Text
import font_benchmark as Benchmark
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.concurrency.thread_native { NativeThread, JoinHandle, SpawnError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.platform.native.host_input { NativeHostInput }
import silk.system.host_input_native { OsHostInput }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput }
import silk.text.string { String }
import font_harness as Harness
import font_harness_corpus as Corpus
import font_harness_dump as Dump
import font_harness_malformed as Malformed { Errors }
import font_harness_process as Process
import font_harness_random { Random }
import font_harness_fixtures as F
import font_generate_support as G

struct Input { name: String, data: Bytes }
effect fn ignored(error: FileError | OutOfMemoryError) -> () {}
effect fn cleanup(path: &Path) -> () ? &mut Allocator | &mut FileSystem { run Effect.catchAll(FileSystem.removeDirectoryRecursively(path), ignored) }

effect fn inspect(binary: string, font: string, timeout: f64) -> () ! Errors ? &mut HostInput | &mut Allocator {
  let mut result = run Process.execute(binary, &[font], timeout, false)
  if result.timedOut {
    let mut message = run Bytes.copy(b"timed out after ")
    run Benchmark.float(&mut message, timeout)
    run message.append(b"s")
    run Task.abort(run G.text(message.asSlice()))
  }
  if result.code != 0 {
    let mut message = run Bytes.copy(b"exit ")
    run Harness.signed(&mut message, result.code)
    run message.append(b": ")
    let errors = run result.errors.readAll()
    let text = run Text.decode(errors.asSlice())
    run message.append(String.utf8Bytes(Text.last(String.view(&text), 2000)))
    run Task.abort(run G.text(message.asSlice()))
  }
  let _info = run Dump.inspect(&mut result.output)
}
effect fn checkIn(binary: string, name: string, data: &[u8], timeout: f64, failures: string, directory: &Path) -> Bytes
  ! Errors ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let font = run Path.join(directory, "input.font")
  run FileSystem.writeFile(&font, data)
  let text = run Corpus.pathText(&font)
  match move run Effect.result(inspect(binary, String.view(&text), timeout)) {
    Result<(), Errors>.Success { .. } => { return Bytes.make() }
    Result<(), Errors>.Failure { error } => {
      let message = match move error { TaskError failure => move failure.message _ => run String.copy("process or dump inspection failed") }
      let hash = run Dump.sha(data)
      let failureDirectory = run Corpus.resolve(failures)
      let destination = run Path.join(&failureDirectory, String.view(&hash))
      run FileSystem.createDirectoriesRecursively(&destination)
      let saved = run Path.join(&destination, "input.font")
      run FileSystem.writeFile(&saved, data)
      let root = run Task.root()
      let artifact = run Corpus.pathText(&saved)
      let mut result = run Bytes.copy(b"{\"case\":")
      run Corpus.quote(&mut result, name)
      run result.append(b",\"error\":")
      run Corpus.quote(&mut result, String.view(&message))
      run result.append(b",\"artifact\":")
      run Corpus.quote(&mut result, Corpus.display(&root, &artifact))
      run result.append(b"}")
      return move result
    }
  }
}
pub effect fn check(binary: string, name: string, data: &[u8], timeout: f64, failures: string) -> Bytes
  ! Errors ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let parent = run Path.make("/tmp")
  let temporary = run FileSystem.createTemporaryDirectory(&parent, b"read-fonts-robustness-")
  return run Effect.ensuring(checkIn(binary, name, data, timeout, failures, &temporary), cleanup(&temporary))
}
effect fn worker(binary: string, name: string, data: &[u8], timeout: f64, failures: string) -> Bytes ! Errors ? &mut Allocator {
  let snapshot = run unsafe NativeHostInput.environmentSnapshot()
  let mut inputs = OsHostInput.make(move snapshot)
  let mut files = run MachineFileSystem.make()
  return run check(binary, name, data, timeout, failures) |> Effect.provideMut<HostInput>(&mut inputs) |> Effect.provideMut<FileSystem>(&mut files)
}
pub effect fn checkRobustness(fonts: string, silk: string, perFont: usize, seed: i64, timeout: f64, jobs: usize, failures: string) -> ()
  ! Errors ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let corpus = run Corpus.load(fonts)
  let binary = run Harness.silkBinary(silk)
  let workers = run Harness.jobs(jobs)
  let root = run Task.root()
  let mut inputs = List<Option<Input>>.make()
  let paths = corpus.fonts.asSlice()
  let mut at: usize = 0
  while at < paths.length {
    let path = run Path.make(String.view(&paths[at]))
    let data = run FileSystem.readFile(&path)
    let name = Corpus.display(&root, &paths[at])
    let clean = inputs.length()
    run inputs.append(Option<Input>.none())
    if perFont > 0 {
      let recipes = run Malformed.mutations(data.asSlice(), seed)
      let seedText = run Malformed.signed(seed)
      let seedName = run F.label(&[String.view(&seedText), ":", name])
      let mut random = run Random.text(String.utf8Bytes(String.view(&seedName)))
      let selected = run random.sample(recipes.length(), F.minimum(perFont, recipes.length()))
      let indices = selected.asSlice()
      let variants = recipes.asSlice()
      // Original clean input precedes the sampled mutations for each font.
      let mut k: usize = 0
      while k < indices.length {
        let recipe = &variants[indices[k]]
        let json = run Malformed.recipeLabel(recipe)
        let mut label = run String.copy(name)
        run String.append(&mut label, " ")
        run String.append(&mut label, run G.text(json.asSlice()))
        run inputs.append(Option<Input>.some(Input { name: move label, data: run Malformed.changed(data.asSlice(), recipe) }))
        k = k + 1
      }
    }
    let slots = inputs.asMutSlice()
    slots[clean] = Option<Input>.some(Input { name: run String.copy(name), data: move data })
    at = at + 1
  }
  let total = inputs.length()
  let mut failed: usize = 0
  at = 0
  while at < total {
    let mut handles = List<JoinHandle<Result<Bytes, Errors>>>.make()
    let mut started: usize = 0
    while started < workers && at < total {
      let input = match move Intrinsic.replace(inputs.asMutSlice()[at], Option<Input>.none()) {
        Option<Input>.Some { value } => move value
        Option<Input>.None => run Task.abort("missing robustness work item")
      }
      at = at + 1
      let binary = run String.copy(String.view(&binary))
      let failures = run String.copy(failures)
      let handle = match move run Effect.result(NativeThread.spawn(fn() -> Result<Bytes, Errors> {
        let ownedBinary = move binary
        let ownedInput = move input
        let ownedFailures = move failures
        let mut allocator = Allocator.systemAllocatorProvider()
        return run Effect.result(worker(String.view(&ownedBinary), String.view(&ownedInput.name), ownedInput.data.asSlice(), timeout, String.view(&ownedFailures))) |> Effect.provideMut<Allocator>(&mut allocator)
      })) {
        Result<JoinHandle<Result<Bytes, Errors>>, SpawnError | OutOfMemoryError>.Success { value } => move value
        Result<JoinHandle<Result<Bytes, Errors>>, SpawnError | OutOfMemoryError>.Failure { .. } => run Task.abort("cannot start robustness worker")
      }
      run handles.append(move handle)
      started = started + 1
    }
    while handles.length() > 0 {
      let handle = handles.remove(0)
      let failure = match move handle.join() { Result<Bytes, Errors>.Success { value } => move value Result<Bytes, Errors>.Failure { error } => { fail move error } }
      if failure.length() > 0 { failed = failed + 1  run Process.print(b"FAIL ")  run Process.print(failure.asSlice())  run Process.print(b"\n") }
    }
  }
  let mut summary = run Bytes.copy(if failed > 0 { b"FAIL: " } else { b"OK: " })
  run Corpus.appendNumber(&mut summary, total - failed)
  run summary.append(b"/")
  run Corpus.appendNumber(&mut summary, total)
  run summary.append(b" dumps clean (")
  run Corpus.appendNumber(&mut summary, paths.length)
  run summary.append(b" fonts, ")
  run Corpus.appendNumber(&mut summary, perFont)
  run summary.append(b" corrupted variants each)\n")
  run Process.print(summary.asSlice())
  if failed > 0 { run Task.abort("robustness campaign failed") }
}
