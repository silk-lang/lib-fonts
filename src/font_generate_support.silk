import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileSystem, FileError, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.regex { Regex, RegexError, Match }
import silk.text.string { String, InvalidUtf8 }
import silk.num.u8
import silk.num.usize
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }

pub const HEADER: string = "// THIS FILE IS AUTOGENERATED. DO NOT EDIT.\n// Copyright 2022 the Fontations Authors. Licensed under Apache-2.0 or MIT.\n"

pub effect fn require(ok: bool, message: string) -> () ! TaskError | OutOfMemoryError ? &mut Allocator {
  if !ok { run Task.abort(message) }
}
pub effect fn text<'a>(bytes: &'a [u8]) -> string<'a> ! TaskError | OutOfMemoryError ? &mut Allocator {
  return match move String.fromUtf8(bytes) {
    Result<string<'a>, InvalidUtf8>.Success { value } => value
    Result<string<'a>, InvalidUtf8>.Failure { .. } => run Task.abort("Generator input is not UTF-8")
  }
}
pub effect fn read(root: &Path, relative: string) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let path = run Path.resolve(root, relative)
  return run FileSystem.readFile(&path)
}
pub effect fn save(root: &Path, relative: string, content: &Bytes, check: bool) -> ()
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let path = run Path.resolve(root, relative)
  if !check { return run FileSystem.writeFileWithParents(&path, Bytes.asSlice(content)) }
  if !run FileSystem.exists(&path) { run Task.abort(relative) }
  // Generated files are committed formatted. Format the candidate beside its target, so the
  // same package configuration applies, and compare that with the committed file.
  let parent = match move run Path.parent(&path) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Task.abort(relative)
  }
  let name = Path.name(&path) |> Option<string>.unwrapOr("generated.silk")
  let scratch = run FileSystem.temporaryDirectory(&parent, ".generate-check-")
  let compared = run Effect.result(formattedEqual(&scratch.path, name, &path, content))
  run FileSystem.release(move scratch)
  match move compared {
    Result<bool, TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError>.Success { value } => {
      if !value { run Task.abort(relative) }
    }
    Result<bool, TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError>.Failure { error } => { fail move error }
  }
}
effect fn formattedEqual(scratch: &Path, name: string, committed: &Path, content: &Bytes) -> bool
  ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let candidate = run Path.join(scratch, name)
  run FileSystem.writeFile(&candidate, Bytes.asSlice(content))
  run Task.silk(&["format", Path.view(&candidate) |> Option<string>.unwrapOr("")])
  let formatted = run FileSystem.readFile(&candidate)
  let existing = run FileSystem.readFile(committed)
  let a = Bytes.asSlice(&existing)
  let b = Bytes.asSlice(&formatted)
  if a.length != b.length { return false }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] { return false }
    i = i + 1
  }
  return true
}
pub effect fn add(out: &mut Bytes, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut out, String.utf8Bytes(value))
}
pub effect fn decimal(out: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 24] = [0; 24]
  let mut n = value
  let mut at: usize = 24
  while true {
    at = at - 1 digits[at] = usize.toU8(n % 10) + 48 n = n / 10
    if n == 0 { break }
  }
  run Bytes.append(&mut out, Slice.view<u8>(&digits, at, 24 - at))
}
pub effect fn blob(out: &mut Bytes, name: string, data: &[u8], public: bool) -> () ! OutOfMemoryError ? &mut Allocator {
  if public { run add(&mut out, "pub ") }
  run add(&mut out, "fn ") run add(&mut out, name) run add(&mut out, "() -> &'static [u8] { return b\"")
  let hex = b"0123456789abcdef"
  run Bytes.reserve(&mut out, data.length * 4 + 5)
  let mut byteIndex: usize = 0
  while byteIndex < data.length {
    let byte = data[byteIndex] byteIndex = byteIndex + 1
    let b = u8.toUsize(byte)
    let escaped: [u8; 4] = [92, 120, hex[b / 16], hex[b % 16]]
    run Bytes.append(&mut out, &escaped)
  }
  run add(&mut out, "\" }\n")
}
pub effect fn be(out: &mut Bytes, value: usize, width: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut buffer: [u8; 8] = [0; 8]
  let mut at = width let mut n = value
  while at > 0 { at = at - 1 buffer[at] = usize.toU8(n % 256) n = n / 256 }
  run Bytes.append(&mut out, Slice.view<u8>(&buffer, 0, width))
}
pub fn patch(out: &mut Bytes, at: usize, value: usize, width: usize) -> () {
  let data = Bytes.asMutSlice(&mut out)
  let mut n = value let mut i = width
  while i > 0 { i = i - 1 data[at + i] = usize.toU8(n % 256) n = n / 256 }
}
pub effect fn zeros(out: &mut Bytes, count: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i: usize = 0
  while i < count { run Bytes.append(&mut out, b"\0") i = i + 1 }
}
pub fn numberAt(data: &[u8], at: usize, width: usize) -> usize {
  let mut n: usize = 0 let mut i: usize = 0
  while i < width { n = n * 256 + u8.toUsize(data[at + i]) i = i + 1 }
  return n
}
pub effect fn number(value: string) -> usize ! TaskError | OutOfMemoryError ? &mut Allocator {
  let input = String.utf8Bytes(String.trim(value))
  let mut radix: usize = 10 let mut i: usize = 0 let mut n: usize = 0
  if input.length > 2 && input[0] == 48 {
    if input[1] == 120 || input[1] == 88 { radix = 16 i = 2 }
    else if input[1] == 98 || input[1] == 66 { radix = 2 i = 2 }
    else if input[1] == 111 || input[1] == 79 { radix = 8 i = 2 }
  }
  run require(i < input.length, "Empty integer in generator input")
  while i < input.length {
    let c = u8.toUsize(input[i]) i = i + 1
    if c == 95 { continue }
    let mut digit: usize = 99
    if c >= 48 && c <= 57 { digit = c - 48 }
    else if c >= 65 && c <= 70 { digit = c - 65 + 10 }
    else if c >= 97 && c <= 102 { digit = c - 97 + 10 }
    run require(digit < radix, "Invalid integer in generator input")
    n = n * radix + digit
  }
  return n
}
effect fn regexFailure(error: RegexError) -> never ! TaskError | OutOfMemoryError ? &mut Allocator {
  run Task.abort("Generator regular expression failed")
}
pub effect fn matches<'a>(pattern: string, source: string<'a>) -> List<Match<'a>> ! TaskError | OutOfMemoryError ? &mut Allocator {
  let compiled = run Effect.catch<RegexError>(Regex.compile(pattern), regexFailure)
  let mut found = List<Match<'a>>.make()
  let mut at: usize = 0
  while at < String.byteLength(source) {
    let remaining = String.slice(source, at, String.byteLength(source) - at)
    let result = run Effect.catch<RegexError>(Regex.find(&compiled, remaining), regexFailure)
    match move result {
      Option<Match<'a>>.None => { break }
      Option<Match<'a>>.Some { value } => {
        let end = Match.end(&value)
        run require(end > 0, "Empty match in generator expression")
        at = at + end run List<Match<'a>>.append(&mut found, move value)
      }
    }
  }
  return move found
}
pub fn group<'a>(found: &Match<'a>, index: usize) -> string<'a> {
  return Match.group(found, index) |> Option<string<'a>>.unwrapOr("")
}
pub effect fn replace(source: string, old: string, replacement: string) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make() let mut rest = source
  while true {
    match move String.find(rest, old) {
      Option<usize>.None => { run add(&mut out, rest) break }
      Option<usize>.Some { value } => {
        run add(&mut out, String.slice(rest, 0, value)) run add(&mut out, replacement)
        let start = value + String.byteLength(old)
        rest = String.slice(rest, start, String.byteLength(rest) - start)
      }
    }
  }
  return move out
}
pub effect fn after<'a>(source: string<'a>, marker: string) -> string<'a> ! TaskError | OutOfMemoryError ? &mut Allocator {
  let at = match move String.find(source, marker) { Option<usize>.Some { value } => value + String.byteLength(marker) _ => run Task.abort("Missing generator source marker") }
  return String.slice(source, at, String.byteLength(source) - at)
}
pub effect fn before<'a>(source: string<'a>, marker: string) -> string<'a> ! TaskError | OutOfMemoryError ? &mut Allocator {
  let at = match move String.find(source, marker) { Option<usize>.Some { value } => value _ => run Task.abort("Missing generator source terminator") }
  return String.slice(source, 0, at)
}
pub effect fn comments(source: string) -> Bytes ! TaskError | OutOfMemoryError ? &mut Allocator {
  let found = run matches("(?s:/\\*.*?\\*/)|//[^\\n]*", source)
  let mut out = Bytes.make() let mut rest = source
  let items = List<Match>.asSlice(&found) let mut i: usize = 0
  while i < items.length {
    let item = &items[i] i = i + 1
    let begin = Match.start(item) let end = Match.end(item)
    run add(&mut out, String.slice(rest, 0, begin))
    rest = String.slice(rest, end, String.byteLength(rest) - end)
  }
  run add(&mut out, rest) return move out
}
pub effect fn initializer(source: string, name: string) -> Bytes ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut pattern = Bytes.make()
  run add(&mut pattern, "(?s:\\b") run add(&mut pattern, name) run add(&mut pattern, "\\b[^=]*=\\s*&?\\[(.*?)\\];)")
  let found = run matches(run text(Bytes.asSlice(&pattern)), source)
  run require(List<Match>.length(&found) > 0, "Missing upstream initializer")
  return run comments(group(&List<Match>.asSlice(&found)[0], 1))
}
pub effect fn numericBytes(source: string, pattern: string, width: usize) -> Bytes ! TaskError | OutOfMemoryError ? &mut Allocator {
  let found = run matches(pattern, source) let mut out = Bytes.make()
  let items = List<Match>.asSlice(&found) let mut i: usize = 0
  while i < items.length {
    let item = &items[i] i = i + 1
    let value = run number(group(item, 0))
    run require((width != 1 || value <= 255) && (width != 2 || value <= 65535) && (width != 4 || value <= 4294967295), "Fixture integer exceeds its packed width")
    run be(&mut out, value, width)
  }
  return move out
}
pub effect fn title(source: string) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make() let mut initial = true
  let data = String.utf8Bytes(source) let mut i: usize = 0
  while i < data.length {
    let byte = data[i] i = i + 1
    let mut c = byte
    if c >= 65 && c <= 90 { if !initial { c = c + 32 } initial = false }
    else if c >= 97 && c <= 122 { if initial { c = c - 32 } initial = false }
    else { initial = true }
    run Bytes.append(&mut out, &[c])
  }
  return move out
}
pub effect fn camel(source: string) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = Bytes.make() let mut initial = true
  let data = String.utf8Bytes(source) let mut i: usize = 0
  while i < data.length {
    let byte = data[i] i = i + 1
    if byte == 95 || byte == 45 { initial = true continue }
    let mut c = byte
    if c >= 65 && c <= 90 && !initial { c = c + 32 }
    else if c >= 97 && c <= 122 && initial { c = c - 32 }
    initial = false run Bytes.append(&mut out, &[c])
  }
  return move out
}
pub effect fn table<'a>(data: &'a [u8], tag: string) -> Option<&'a [u8]> ! TaskError | OutOfMemoryError ? &mut Allocator {
  run require(data.length >= 12, "Truncated fixture font header")
  let count = numberAt(data, 4, 2)
  run require(count <= (data.length - 12) / 16, "Truncated fixture font directory")
  let wanted = String.utf8Bytes(tag)
  let mut i: usize = 0
  while i < count {
    let at = 12 + i * 16 i = i + 1
    if data[at] != wanted[0] || data[at + 1] != wanted[1] || data[at + 2] != wanted[2] || data[at + 3] != wanted[3] { continue }
    let offset = numberAt(data, at + 8, 4) let length = numberAt(data, at + 12, 4)
    run require(offset <= data.length && length <= data.length - offset, "Truncated fixture font table")
    return Option<&'a [u8]>.some(Slice.view<u8>(data, offset, length))
  }
  return Option<&'a [u8]>.none()
}
pub effect fn included(root: &Path, source: string, symbol: string) -> Bytes ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  let mut pattern = Bytes.make() run add(&mut pattern, "pub static ") run add(&mut pattern, symbol)
  run add(&mut pattern, ":[^=]*=\\s*include_bytes!\\(\"([^\"]+)\"\\)")
  let found = run matches(run text(Bytes.asSlice(&pattern)), source)
  run require(List<Match>.length(&found) > 0, "Missing include_bytes fixture")
  let base = run Path.resolve(root, "modules/parse/upstream/font-test-data/src")
  return run read(&base, group(&List<Match>.asSlice(&found)[0], 1))
}

pub effect fn report(check: bool, message: string) -> () ! OutOfMemoryError | WriterError ? &mut Allocator {
  let mut line = Bytes.make()
  if check { run add(&mut line, "Checked ") } else { run add(&mut line, "Generated ") }
  run add(&mut line, message) run add(&mut line, "\n")
  let mut stdout = StdoutWriter.make()
  run Writer.writeAll(Bytes.asSlice(&line)) |> Effect.provideMut<Writer>(&mut stdout)
}
pub fn count(source: string, needle: string) -> usize {
  let mut rest = source let mut total: usize = 0
  while true {
    match move String.find(rest, needle) {
      Option<usize>.None => { return total }
      Option<usize>.Some { value } => {
        total = total + 1
        let at = value + String.byteLength(needle)
        rest = String.slice(rest, at, String.byteLength(rest) - at)
      }
    }
  }
  return total
}
