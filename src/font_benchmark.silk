import font_harness_text as Text
import font_benchmark_platform as Platform
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.system_clock { SystemClock }
import silk.system.system_clock_native { OsSystemClock }
import silk.text.format { Format }
import silk.text.string { String }
import silk.num.i64
import silk.num.i32
import silk.num.usize
import font_harness_process as Process
import font_harness_corpus as Corpus
import font_harness_dump as Dump

type Errors = TaskError | FileError | HostInputError | OutOfMemoryError | WriterError | ProcessError
@foreign(noCapture: .("from", "to"))
unsafe extern "C" fn rename(from: ?[*]const u8, to: ?[*]const u8) -> i32
extern "C" struct Tm { second: i32, minute: i32, hour: i32, day: i32, month: i32, year: i32, weekday: i32, yearday: i32, dst: i32, offset: i64, zone: ?*const u8 }
unsafe extern "C" fn gmtime_r(time: *const i64, result: *mut Tm) -> ?*mut Tm
unsafe extern "C" fn strftime(output: ?[*]mut u8, length: usize, format: ?[*]const u8, time: *const Tm) -> usize

pub effect fn float(output: &mut Bytes, value: f64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut buffer: [u8; 25] = [0; 25]
  let count = Format.writeF64Debug(value, &mut buffer, 0)
  run output.append(Slice.view<u8>(&buffer, 0, count))
}

effect fn timestamp() -> String ! TaskError | OutOfMemoryError ? &mut Allocator {
  let mut clock = OsSystemClock.make()
  let now = run SystemClock.now() |> Effect.provideMut<SystemClock>(&mut clock)
  let seconds = SystemClock.seconds(&now)
  let mut tm = Tm { second: 0, minute: 0, hour: 0, day: 0, month: 0, year: 0, weekday: 0, yearday: 0, dst: 0, offset: 0, zone: Pointer.null<u8>() }
  if Pointer.isNull(unsafe gmtime_r(Pointer.fromRef(&seconds), Pointer.fromMutRef(&mut tm))) { run Task.abort("cannot format benchmark timestamp") }
  let mut buffer: [u8; 32] = [0; 32]
  let count = unsafe strftime(Pointer.fromMutSlice(&mut buffer), 32, Pointer.fromSlice(b"%Y-%m-%dT%H:%M:%S\x00"), Pointer.fromRef(&tm))
  let mut result = run Bytes.copy(Slice.view<u8>(&buffer, 0, count))
  run result.append(b".")
  let mut fraction = SystemClock.nanoseconds(&now) / 1000
  let mut digits: [u8; 6] = [48; 6]
  let mut at: usize = 6
  while at > 0 { at = at - 1  digits[at] = i64.toU8(fraction % 10) + 48  fraction = fraction / 10 }
  run result.append(&digits)
  run result.append(b"+00:00")
  return unsafe String.fromBytesUnchecked(move result)
}

pub effect fn atomicSave(report: string, bytes: &[u8]) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let destination = run Corpus.resolve(report)
  let mut temp = run Bytes.copy(Path.rawBytes(&destination))
  run temp.append(b".tmp")
  let temporary = run Path.fromBytes(temp.asSlice())
  run FileSystem.writeFileWithParents(&temporary, bytes)
  run temp.append(b"\x00")
  let mut final = run Bytes.copy(Path.rawBytes(&destination))
  run final.append(b"\x00")
  if unsafe rename(Pointer.fromSlice(temp.asSlice()), Pointer.fromSlice(final.asSlice())) != 0 { run Task.abort("cannot publish benchmark report") }
}

struct Report { name: String, base: Bytes, warmup: Bytes, rounds: Bytes }
impl Report {
  effect fn save(self: &Self, tail: &[u8]) -> () ! TaskError | FileError | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let mut bytes = run Bytes.copy(self.base.asSlice())
    run bytes.append(b",\"warmup\":{")
    run bytes.append(self.warmup.asSlice())
    run bytes.append(b"},\"rounds\":[")
    run bytes.append(self.rounds.asSlice())
    run bytes.append(b"]")
    run bytes.append(tail)
    run bytes.append(b"}\n")
    run atomicSave(String.view(&self.name), bytes.asSlice())
  }
}

struct Measurement { seconds: f64, json: Bytes }

effect fn measure(name: string, binary: string, fonts: &[String], timeout: f64, report: &Report) -> Measurement
  ! Errors ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = run Task.root()
  let mut samples = run Bytes.copy(b"[")
  let start = run Process.now()
  let mut at: usize = 0
  while at < fonts.length {
    let before = run Process.now()
    let result = run Effect.result(Process.execute(binary, &[String.view(&fonts[at])], timeout, true))
    match move result {
      Result<Process.RunResult, TaskError | FileError | HostInputError | OutOfMemoryError>.Failure { error } => {
        let mut failure = run Bytes.copy(b",\"failure\":{\"program\":")
        run Corpus.quote(&mut failure, name)
        run failure.append(b",\"font\":")
        run Corpus.quote(&mut failure, Corpus.display(&root, &fonts[at]))
        run failure.append(b",\"error\":\"cannot run benchmark executable\"}")
        run report.save(failure.asSlice())
        fail move error
      }
      Result<Process.RunResult, TaskError | FileError | HostInputError | OutOfMemoryError>.Success { value } => {
        let mut result = move value
        if result.timedOut || result.code != 0 {
          let mut failure = run Bytes.copy(b",\"failure\":{\"program\":")
          run Corpus.quote(&mut failure, name)
          run failure.append(b",\"font\":")
          run Corpus.quote(&mut failure, Corpus.display(&root, &fonts[at]))
          if result.timedOut { run failure.append(b",\"error\":\"subprocess timed out\"}") }
          else {
            run failure.append(b",\"returncode\":")
            let mut number: [u8; 20] = [0; 20]
            let length = Format.writeI64Display(i32.toI64(result.code), &mut number, 0)
            run failure.append(Slice.view<u8>(&number, 0, length))
            run failure.append(b",\"stderr\":")
            let errors = run result.errors.readAll()
            let text = run Text.replace(errors.asSlice())
            run Corpus.quote(&mut failure, String.view(&text))
            run failure.append(b"}")
          }
          run report.save(failure.asSlice())
          run Task.abort("benchmark subprocess failed")
        }
      }
    }
    if at > 0 { run samples.append(b",") }
    run float(&mut samples, (run Process.now()) - before)
    at = at + 1
  }
  let seconds = (run Process.now()) - start
  run samples.append(b"]")
  let mut json = run Bytes.copy(b"{\"seconds\":")
  run float(&mut json, seconds)
  run json.append(b",\"per_font_seconds\":")
  run json.append(samples.asSlice())
  run json.append(b"}")
  return Measurement { seconds: seconds, json: move json }
}


pub effect fn benchmark(fonts: string, reference: string, silk: string, rounds: usize, timeout: f64, report: string) -> ()
  ! Errors ? &mut HostInput | &mut Allocator | &mut FileSystem | &mut ChildProcess {
  if rounds < 1 || timeout <= 0.0 { run Task.abort("rounds and timeout must be positive") }
  if report == "" { run Task.abort("--report is required") }
  let corpus = run Corpus.load(fonts)
  let root = run Task.root()
  let paths = corpus.fonts.asSlice()
  let mut files = run Bytes.copy(b"[")
  let mut canonical = run Bytes.copy(b"[")
  let mut at: usize = 0
  while at < paths.length {
    let path = run Path.make(String.view(&paths[at]))
    let data = run FileSystem.readFile(&path)
    let hash = run Dump.sha(data.asSlice())
    if at > 0 { run files.append(b",")  run canonical.append(b", ") }
    run files.append(b"{\"path\":")
    run Corpus.quote(&mut files, Corpus.display(&root, &paths[at]))
    run files.append(b",\"bytes\":")
    run Corpus.appendNumber(&mut files, data.length())
    run files.append(b",\"sha256\":")
    run Corpus.quote(&mut files, String.view(&hash))
    run files.append(b"}")
    // Match json.dumps(files, sort_keys=True), including its separators.
    run canonical.append(b"{\"bytes\": ")
    run Corpus.appendNumber(&mut canonical, data.length())
    run canonical.append(b", \"path\": ")
    run Text.jsonAscii(&mut canonical, Corpus.display(&root, &paths[at]))
    run canonical.append(b", \"sha256\": ")
    run Corpus.quote(&mut canonical, String.view(&hash))
    run canonical.append(b"}")
    at = at + 1
  }
  run files.append(b"]")
  run canonical.append(b"]")
  let corpusHash = run Dump.sha(canonical.asSlice())
  let platform = run Platform.current()
  let platformText = move platform.name
  let processorText = move platform.processor
  let mut cpu = String.make()
  let cpuPath = run Path.make("/proc/cpuinfo")
  if run FileSystem.exists(&cpuPath) {
    let data = run FileSystem.readFile(&cpuPath)
    let text = run Corpus.utf8(data.asSlice())
    let mut lines = String.split(String.view(&text), "\n")
    while let Option<string>.Some { value } = move lines.next() {
      if String.startsWith(value, "model name") {
        let mut parts = String.split(value, ":")
        let _key = parts.next()
        if let Option<string>.Some { value: remaining } = move parts.remainder() { cpu = run Corpus.utf8(Process.trim(String.utf8Bytes(remaining))) }
        break
      }
    }
  }
  let started = run timestamp()
  let mut state = Report { name: run String.copy(report), base: run Bytes.copy(b"{\"method\":\"one subprocess per font; stdout=/dev/null; serial wall time; one whole-corpus warmup per binary; alternating program order by timed round\",\"platform\":"), warmup: Bytes.make(), rounds: Bytes.make() }
  run Corpus.quote(&mut state.base, String.view(&platformText))
  run state.base.append(b",\"processor\":")
  run Corpus.quote(&mut state.base, String.view(&processorText))
  run state.base.append(b",\"cpu_model\":")
  run Corpus.quote(&mut state.base, String.view(&cpu))
  run state.base.append(b",\"started_at\":")
  run Corpus.quote(&mut state.base, String.view(&started))
  run state.base.append(b",\"format_version\":9,\"fonts\":")
  run state.base.append(files.asSlice())
  run state.base.append(b",\"corpus_inventory\":")
  run state.base.append(corpus.inventory.asSlice())
  run state.base.append(b",\"corpus_sha256\":")
  run Corpus.quote(&mut state.base, String.view(&corpusHash))
  run state.base.append(b",\"binaries\":{")
  let binaries = [reference, silk]
  let names = ["rust", "silk"]
  at = 0
  while at < 2 {
    if at > 0 { run state.base.append(b",") }
    run Corpus.quote(&mut state.base, names[at])
    run state.base.append(b":{\"path\":")
    let path = run Corpus.absolute(binaries[at])
    run Corpus.quote(&mut state.base, Corpus.display(&root, &path))
    run state.base.append(b",\"sha256\":")
    let hash = run Dump.fileSha(binaries[at])
    run Corpus.quote(&mut state.base, String.view(&hash))
    run state.base.append(b",\"version\":")
    let version = run Task.capture(binaries[at], &["--version"])
    let versionText = run Corpus.utf8(Process.trim(version.asSlice()))
    run Corpus.quote(&mut state.base, String.view(&versionText))
    run state.base.append(b"}")
    at = at + 1
  }
  run state.base.append(b"}")
  run state.save(b"")
  let mut writer = StdoutWriter.make()
  at = 0
  while at < 2 {
    let measurement = run measure(names[at], binaries[at], paths, timeout, &state)
    if at > 0 { run state.warmup.append(b",") }
    run Corpus.quote(&mut state.warmup, names[at])
    run state.warmup.append(b":")
    run state.warmup.append(measurement.json.asSlice())
    run state.save(b"")
    run Format.format("warmup {name}: {seconds:.3}s\n", &.{ name: names[at], seconds: measurement.seconds }) |> Effect.provideMut<Writer>(&mut writer)
    at = at + 1
  }
  let mut rustTimes = List<f64>.make()
  let mut silkTimes = List<f64>.make()
  at = 0
  while at < rounds {
    let first = at % 2
    let second = 1 - first
    let a = run measure(names[first], binaries[first], paths, timeout, &state)
    run Format.format("round {round} {name}: {seconds:.3}s\n", &.{ round: at + 1, name: names[first], seconds: a.seconds }) |> Effect.provideMut<Writer>(&mut writer)
    let b = run measure(names[second], binaries[second], paths, timeout, &state)
    run Format.format("round {round} {name}: {seconds:.3}s\n", &.{ round: at + 1, name: names[second], seconds: b.seconds }) |> Effect.provideMut<Writer>(&mut writer)
    if at > 0 { run state.rounds.append(b",") }
    run state.rounds.append(b"{\"order\":[")
    run Corpus.quote(&mut state.rounds, names[first])
    run state.rounds.append(b",")
    run Corpus.quote(&mut state.rounds, names[second])
    run state.rounds.append(b"],")
    run Corpus.quote(&mut state.rounds, names[first])
    run state.rounds.append(b":")
    run state.rounds.append(a.json.asSlice())
    run state.rounds.append(b",")
    run Corpus.quote(&mut state.rounds, names[second])
    run state.rounds.append(b":")
    run state.rounds.append(b.json.asSlice())
    run state.rounds.append(b"}")
    run rustTimes.append(if first == 0 { a.seconds } else { b.seconds })
    run silkTimes.append(if first == 1 { a.seconds } else { b.seconds })
    run state.save(b"")
    at = at + 1
  }
  run rustTimes.sort()
  run silkTimes.sort()
  let rustMedian = median(rustTimes.asSlice())
  let silkMedian = median(silkTimes.asSlice())
  let mut summary = run Bytes.copy(b"{\"fonts\":")
  run Corpus.appendNumber(&mut summary, paths.length)
  run summary.append(b",\"rounds\":")
  run Corpus.appendNumber(&mut summary, rounds)
  run summary.append(b",\"median_seconds\":{\"rust\":")
  run float(&mut summary, rustMedian)
  run summary.append(b",\"silk\":")
  run float(&mut summary, silkMedian)
  run summary.append(b"},\"silk_over_rust_wall_time\":")
  run float(&mut summary, silkMedian / rustMedian)
  run summary.append(b"}")
  let mut tail = run Bytes.copy(b",\"summary\":")
  run tail.append(summary.asSlice())
  run state.save(tail.asSlice())
  run summary.append(b"\n")
  run Process.print(summary.asSlice())
}

fn median(values: &[f64]) -> f64 {
  let middle = values.length / 2
  if values.length % 2 == 1 { return values[middle] }
  return (values[middle - 1] + values[middle]) / 2.0
}
