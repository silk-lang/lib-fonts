import font_shape_generate_common as G
import font_shape_generate_common { Hit, Tag }
import silk.cli.task { TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.text.string { String }
import silk.num.u8
import silk.num.usize

pub effect fn generateShapingLanguages(root: &Path) -> ()
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let raw = run G.source(root, "tag_table.rs")
  let src = run G.replace(String.view(&raw), "//[^\\n]*", "")
  let languageMatches = run G.hits(
    "LangTag \\{ language: lang\\(b\"([^\"]+)\"\\),\\s*tag: Tag::new\\((b\"[^\"]+\"|&\\[0; 4\\])\\) \\}",
    String.view(&src),
  )
  let rows = List<Hit>.asSlice(&languageMatches)
  run G.require(rows.length > 1000, "missing OpenType language rows")
  let mut data = Bytes.make()
  let mut i: usize = 0
  while i < rows.length {
    let language = G.group(&rows[i], 1)
    run Bytes.append(&mut data, String.utf8Bytes(language))
    let mut pad = String.byteLength(language)
    while pad < 4 {
      run G.integer(&mut data, 0, 1)
      pad = pad + 1
    }
    let tag = G.group(&rows[i], 2)
    if String.startsWith(tag, "&") {
      run G.integer(&mut data, 0, 4)
    } else {
      run Bytes.append(
        &mut data,
        String.utf8Bytes(String.slice(tag, 2, String.byteLength(tag) - 3)),
      )
    }
    i = i + 1
  }
  let mut out = run String.copy(
    "// THIS FILE IS AUTOGENERATED by silk task generate-shaping-languages. DO NOT EDIT.\n// Harfrust/HarfBuzz OpenType tag mappings, MIT licensed.\nimport language { LanguageTags, add, langMatches, subtagMatches, strncmp }\nimport silk.text.string { String }\n",
  )
  run G.byteFunction(&mut out, "languages", Bytes.asSlice(&data))
  let complex = run G.after(String.view(&src), "pub fn tags_from_complex_language")
  let start = (run G.index(complex, "{")) + 1
  let end = String.findLast(complex, "}") |> Option<usize>.unwrapOr(0)
  run G.require(end >= start, "missing complex language body")
  let mut code = run G.replace(
    String.slice(complex, start, end - start),
    "match language\\.as_bytes\\(\\)\\[0\\]",
    "match String.utf8Bytes(language)[0]",
  )
  code = run byteCharacters(String.view(&code))
  code = run G.replace(String.view(&code), "&language\\[1\\.\\.\\]", "rest")
  code = run tagLists(String.view(&code))
  code = run tagPushes(String.view(&code))
  code = run G.replace(String.view(&code), "lang_matches", "langMatches")
  code = run G.replace(String.view(&code), "subtag_matches", "subtagMatches")
  code = run G.replace(String.view(&code), ";", "")
  code = run G.replace(String.view(&code), "\\}\\s*,", "}")
  code = run G.replace(String.view(&code), "\\n\\s*\\n", "\n")
  code = run G.replace(String.view(&code), "\\bfalse\\s*$", "return false\n")
  let remainingTags = String.find(String.view(&code), "tags.")
  let remainingConstructors = String.find(String.view(&code), "Tag::")
  run G.require(!Option<usize>.isSome(&remainingTags), "untranslated language tag operation")
  run G.require(!Option<usize>.isSome(&remainingConstructors), "untranslated language tag")
  run String.append(
    &mut out,
    "pub fn complex(language: string, tags: &mut LanguageTags) -> bool {\nif String.byteLength(language) == 0 { return false }\nlet rest = String.slice(language, 1, String.byteLength(language) - 1)\n",
  )
  run String.append(&mut out, String.view(&code))
  run String.append(&mut out, "\n}\n")
  let reverseSource = run G.source(root, "tag_reverse.rs")
  let reverseMatches = run G.hits("\\(\\*b\"(....)\", \"([^\"]+)\"\\)", String.view(&reverseSource))
  let reverseRows = List<Hit>.asSlice(&reverseMatches)
  run G.require(reverseRows.length > 400, "missing reverse language mappings")
  Bytes.clear(&mut data)
  let mut pool = Bytes.make()
  i = 0
  while i < reverseRows.length {
    run Bytes.append(&mut data, String.utf8Bytes(G.group(&reverseRows[i], 1)))
    run G.integer(&mut data, usize.toU64(Bytes.length(&pool)), 4)
    let language = String.utf8Bytes(G.group(&reverseRows[i], 2))
    run G.integer(&mut pool, usize.toU64(language.length), 1)
    run Bytes.append(&mut pool, language)
    i = i + 1
  }
  run G.byteFunction(&mut out, "reverseLanguages", Bytes.asSlice(&data))
  run G.byteFunction(&mut out, "reverseNames", Bytes.asSlice(&pool))
  run G.save(root, "modules/shape/src/generated_languages.silk", String.view(&out))
  let scriptNames = run G.scripts(root)
  let scripts = List<Tag>.asSlice(&scriptNames)
  run G.require(scripts.length > 150, "missing ISO 15924 scripts")
  let mut constants = run String.copy(
    "// THIS FILE IS AUTOGENERATED by silk task generate-shaping-languages. DO NOT EDIT.\n// ISO 15924 script identifiers from Harfrust, MIT licensed.\nimport script { Script }\n",
  )
  i = 0
  while i < scripts.length {
    run String.append(&mut constants, "pub fn ")
    let name = String.utf8Bytes(String.view(&scripts[i].name))
    let mut j: usize = 0
    let mut upper = false
    while j < name.length {
      let c = name[j]
      if c == 95 {
        upper = true
      } else {
        let mut letter = c
        if !upper && c >= 65 && c <= 90 {
          letter = c + 32
        }
        let bytes = &[letter]
        run String.append(&mut constants, unsafe String.fromUtf8Unchecked(bytes))
        upper = false
      }
      j = j + 1
    }
    run String.append(&mut constants, "() -> Script { return Script { value: 0x")
    run G.hex(&mut constants, String.utf8Bytes(String.view(&scripts[i].tag)))
    run String.append(&mut constants, " } }\n")
    i = i + 1
  }
  run G.save(root, "modules/shape/src/generated_scripts.silk", String.view(&constants))
  let sourceTests = run G.source(root, "tag.rs")
  let caseMatches = run G.hits(
    "test_tag_from_language!\\((\\w+),\\s*\"([^\"]*)\",\\s*\"([^\"]*)\"\\);",
    String.view(&sourceTests),
  )
  let cases = List<Hit>.asSlice(&caseMatches)
  run G.require(cases.length > 100, "missing upstream language tests")
  Bytes.clear(&mut data)
  i = 0
  while i < cases.length {
    let language = String.utf8Bytes(G.group(&cases[i], 3))
    run G.integer(&mut data, usize.toU64(language.length), 2)
    let tag = String.utf8Bytes(G.group(&cases[i], 2))
    run Bytes.append(&mut data, tag)
    let mut pad = tag.length
    while pad < 4 {
      run Bytes.append(&mut data, b" ")
      pad = pad + 1
    }
    run Bytes.append(&mut data, language)
    i = i + 1
  }
  let mut tests = run String.copy(
    "// THIS FILE IS AUTOGENERATED by silk task generate-shaping-languages. DO NOT EDIT.\n// Upstream tag.rs test cases, MIT licensed.\n",
  )
  run G.byteFunction(&mut tests, "languageCases", Bytes.asSlice(&data))
  run String.append(
    &mut tests,
    "pub fn caseName(index: usize) -> string<'static> { return match index {\n",
  )
  i = 0
  while i < cases.length {
    run G.decimal(&mut tests, usize.toU64(i))
    run String.append(&mut tests, " => \"")
    run String.append(&mut tests, G.group(&cases[i], 1))
    run String.append(&mut tests, "\"\n")
    i = i + 1
  }
  run String.append(&mut tests, "_ => \"unknown language case\" } }\n")
  run G.save(root, "modules/shape/src/generated_language_cases.silk", String.view(&tests))
}

effect fn byteCharacters(text: string) -> String
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let matches = run G.hits("b'(.)'", text)
  let rows = List<Hit>.asSlice(&matches)
  let mut out = String.make()
  let mut at: usize = 0
  let mut i: usize = 0
  while i < rows.length {
    run String.append(&mut out, String.slice(text, at, rows[i].start - at))
    let character = String.utf8Bytes(G.group(&rows[i], 1))
    run G.require(character.length == 1, "non-ASCII byte literal")
    run G.decimal(&mut out, u8.toU64(character[0]))
    at = rows[i].end
    i = i + 1
  }
  run String.append(&mut out, String.slice(text, at, String.byteLength(text) - at))
  return move out
}

effect fn addTag(out: &mut String, tag: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run String.append(&mut out, "add(&mut tags, 0x")
  run G.hex(&mut out, String.utf8Bytes(tag))
  run String.append(&mut out, ")")
}

effect fn tagLists(text: string) -> String
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let matches = run G.hits(
    "let possible_tags = &\\[(?s:(.*?))\\];\\s*tags\\.extend_from_slice\\(possible_tags\\);",
    text,
  )
  let rows = List<Hit>.asSlice(&matches)
  let mut out = String.make()
  let mut at: usize = 0
  let mut i: usize = 0
  while i < rows.length {
    run String.append(&mut out, String.slice(text, at, rows[i].start - at))
    let tagMatches = run G.hits("Tag::new\\(b\"(....)\"\\)", G.group(&rows[i], 1))
    let tags = List<Hit>.asSlice(&tagMatches)
    let mut j: usize = 0
    while j < tags.length {
      if j != 0 {
        run String.append(&mut out, "\n")
      }
      run addTag(&mut out, G.group(&tags[j], 1))
      j = j + 1
    }
    at = rows[i].end
    i = i + 1
  }
  run String.append(&mut out, String.slice(text, at, String.byteLength(text) - at))
  return move out
}

effect fn tagPushes(text: string) -> String
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let matches = run G.hits("tags\\.push\\(Tag::new\\(b\"(....)\"\\)\\);", text)
  let rows = List<Hit>.asSlice(&matches)
  let mut out = String.make()
  let mut at: usize = 0
  let mut i: usize = 0
  while i < rows.length {
    run String.append(&mut out, String.slice(text, at, rows[i].start - at))
    run addTag(&mut out, G.group(&rows[i], 1))
    at = rows[i].end
    i = i + 1
  }
  run String.append(&mut out, String.slice(text, at, String.byteLength(text) - at))
  return move out
}
