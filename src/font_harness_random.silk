import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.crypto.sha2 { Sha512 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.u8

// CPython's version-2 Random seeding and MT19937 getrandbits/randbelow/sample.
// Keeping this algorithm preserves existing campaign recipes and resumable receipts.
pub struct Random { state: [u32; 624], index: usize }
impl Random {
  fn initialized() -> Random {
    let mut result = Random { state: [0; 624], index: 624 }
    result.state[0] = 19650218
    let mut at: usize = 1
    while at < 624 {
      let previous = result.state[at - 1]
      result.state[at] = u32.wrappingAdd(u32.wrappingMultiply(previous ^ (u32.shiftRight(previous, 30)), 1812433253), usize.toU32(at))
      at = at + 1
    }
    return move result
  }
  fn keyed(keys: &[u32]) -> Random {
    let mut result = Random.initialized()
    let mut i: usize = 1
    let mut j: usize = 0
    let mut count: usize = 624
    if keys.length > count { count = keys.length }
    while count > 0 {
      let previous = result.state[i - 1]
      let value = result.state[i] ^ u32.wrappingMultiply(previous ^ (u32.shiftRight(previous, 30)), 1664525)
      result.state[i] = u32.wrappingAdd(u32.wrappingAdd(value, keys[j]), usize.toU32(j))
      i = i + 1
      j = j + 1
      if i >= 624 { result.state[0] = result.state[623]  i = 1 }
      if j >= keys.length { j = 0 }
      count = count - 1
    }
    count = 623
    while count > 0 {
      let previous = result.state[i - 1]
      let value = result.state[i] ^ u32.wrappingMultiply(previous ^ (u32.shiftRight(previous, 30)), 1566083941)
      result.state[i] = u32.wrappingSubtract(value, usize.toU32(i))
      i = i + 1
      if i >= 624 { result.state[0] = result.state[623]  i = 1 }
      count = count - 1
    }
    result.state[0] = 2147483648
    return move result
  }
  pub fn integer(seed: u64) -> Random {
    let keys = [u64.wrappingToU32(seed), u64.toU32(u64.shiftRight(seed, 32))]
    if keys[1] == 0 { return Random.keyed(&[keys[0]]) }
    return Random.keyed(&keys)
  }
  pub effect fn text(seed: &[u8]) -> Random ! OutOfMemoryError ? &mut Allocator {
    let digest = Sha512.hash(seed)
    let mut material = run Bytes.copy(seed)
    run material.append(&digest)
    let bytes = material.asSlice()
    let mut keys = List<u32>.make()
    let mut end = bytes.length
    while end > 0 {
      let start = if end > 4 { end - 4 } else { 0 }
      let mut word: u32 = 0
      let mut at = start
      while at < end { word = u32.shiftLeft(word, 8) | u8.toU32(bytes[at])  at = at + 1 }
      run keys.append(word)
      end = start
    }
    return Random.keyed(keys.asSlice())
  }
  fn word(self: &mut Self) -> u32 {
    if self.index >= 624 {
      let mut at: usize = 0
      while at < 624 {
        let next = (at + 1) % 624
        let y = (self.state[at] & 2147483648) | (self.state[next] & 2147483647)
        let mut twisted = u32.shiftRight(y, 1)
        if y & 1 != 0 { twisted = twisted ^ 2567483615 }
        self.state[at] = self.state[(at + 397) % 624] ^ twisted
        at = at + 1
      }
      self.index = 0
    }
    let mut y = self.state[self.index]
    self.index = self.index + 1
    y = y ^ (u32.shiftRight(y, 11))
    y = y ^ ((u32.shiftLeft(y, 7)) & 2636928640)
    y = y ^ ((u32.shiftLeft(y, 15)) & 4022730752)
    return y ^ (u32.shiftRight(y, 18))
  }
  pub fn below(self: &mut Self, bound: usize) -> usize {
    let mut bits: u32 = 0
    let mut value = bound
    while value > 0 { value = usize.shiftRight(value, 1)  bits = bits + 1 }
    while true {
      let mut selected: u64 = 0
      if bits <= 32 { selected = u32.toU64(u32.shiftRight(self.word(), 32 - bits)) }
      else { selected = u32.toU64(self.word()) | u64.shiftLeft(u32.toU64(u32.shiftRight(self.word(), 64 - bits)), 32) }
      if selected < usize.toU64(bound) { return u64.toUsize(selected) }
    }
    return 0
  }
  pub effect fn sample(self: &mut Self, size: usize, count: usize) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    let mut result = List<usize>.make()
    let mut setsize: usize = 21
    if count > 5 {
      let mut power: usize = 4
      while power < count * 3 { power = power * 4 }
      setsize = setsize + power
    }
    if size <= setsize {
      let mut pool = List<usize>.make()
      let mut at: usize = 0
      while at < size { run pool.append(at)  at = at + 1 }
      at = 0
      while at < count {
        let selected = self.below(size - at)
        let value = pool.asSlice()[selected]
        run result.append(value)
        let replacement = pool.asSlice()[size - at - 1]
        let entries = pool.asMutSlice()
        entries[selected] = replacement
        at = at + 1
      }
    } else {
      let mut at: usize = 0
      while at < count {
        let mut selected = self.below(size)
        while true {
          let previous = result.asSlice()
          let mut duplicate = false
          let mut k: usize = 0
          while k < previous.length { if previous[k] == selected { duplicate = true }  k = k + 1 }
          if !duplicate { break }
          selected = self.below(size)
        }
        run result.append(selected)
        at = at + 1
      }
    }
    return move result
  }
}
