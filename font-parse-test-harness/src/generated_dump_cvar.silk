import read_fonts.tables.variations { TupleVariationCount }

pub effect fn dumpCvar<'a>(path: &mut DumpPath, value: Cvar<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  let dumpArgs = DumpPath.arguments(&path)
  if !run DumpPath.visit(
    &mut path,
    2710019765,
    FontData.len(&Cvar<'a>.offsetData(&value)),
    dumpArgs,
  ) {
    return
  }
  let base = Cvar<'a>.offsetData(&value)
  if true {
    DumpPath.push(&mut path, "version")
    let fieldValue = Cvar<'a>.version(&value)
    DumpPath.push(&mut path, "major")
    run scalar(&path, fieldValue.major)
    DumpPath.pop(&mut path)
    DumpPath.push(&mut path, "minor")
    run scalar(&path, fieldValue.minor)
    DumpPath.pop(&mut path)
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "tupleVariationCount")
    let fieldValue = Cvar<'a>.tupleVariationCount(&value)
    run scalar(&path, TupleVariationCount.bits(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "dataOffset")
    let fieldValue = Cvar<'a>.dataOffset(&value)
    run scalar(&path, Offset16.toU32(fieldValue))
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "data")
    let targetArgs: [u64; 3] = [0, 0, 0]
    DumpPath.setArguments(&mut path, targetArgs)
    let resolved = Cvar<'a>.data(&value)
    match move resolved {
      Result<FontData<'a>, ReadError>.Success { value: table } => run bytes(
        &path,
        FontData.asBytes(&table),
      )
      Result<FontData<'a>, ReadError>.Failure { error } => run readError(&path, error)
    }
    DumpPath.pop(&mut path)
  }
  if true {
    DumpPath.push(&mut path, "tupleVariationHeaders")
    let range = Cvar<'a>.tupleVariationHeadersByteRange(&value)
    let raw = FontData.slice(&base, range.start, range.end)
      |> Option<FontData<'a>>.unwrapOr(FontData.new(&[]))
    run bytes(&path, FontData.asBytes(&raw))
    DumpPath.pop(&mut path)
  }
}

import read_fonts.lib { FontRef }

pub effect fn dumpTables<'a>(path: &mut DumpPath, font: &FontRef<'a>) -> ()
  ! WriterError
  ? &mut Writer {
  if true {
    DumpPath.beginTable(&mut path)
    DumpPath.push(&mut path, "cvar")
    match move FontRef<'a>.tableData(font, Tag.fromU32(1668702578)) {
      Option<FontData<'a>>.None => run readError(
        &path,
        ReadError.TableIsMissing { tag: Tag.fromU32(1668702578) },
      )
      Option<FontData<'a>>.Some { value: data } => {
        match move Cvar<'a>.read(data) {
          Result<Cvar<'a>, ReadError>.Success { value: table } => run dumpCvar(&mut path, table)
          Result<Cvar<'a>, ReadError>.Failure { error } => run readError(&path, error)
        }
      }
    }
    DumpPath.pop(&mut path)
  }
}
